#!/usr/bin/env bash
# Poll the EC2 instance metadata service for spot interruption notices and
# drain the worker when one arrives (2 min lead time) so in-flight builds get
# a chance to finish before AWS reclaims the instance.
#
# Rebalance recommendations are logged but deliberately NOT acted on. Replacing
# the instance on each one (marking it Unhealthy so the ASG swaps it) was the
# single largest cause of worker churn: in the six weeks to 2026-10-16 it
# replaced a median 18-28 workers per weekday in each of QA OCW and the three
# Production pools (peaks of 40-57), 1.6-1.8x the real interruption count.
# The recommendation is advisory -- AWS does not promise an interruption
# follows -- while every replacement throws away running builds and the
# baggageclaim cache. Builds on a reclaimed worker are retried via
# enable_rerun_when_worker_disappears.
set -euo pipefail

POLL_INTERVAL=${POLL_INTERVAL:-5}
METADATA_BASE="http://169.254.169.254/latest/meta-data"
REBALANCE_URL="${METADATA_BASE}/events/recommendations/rebalance"
TERMINATION_TIME_URL="${METADATA_BASE}/spot/termination-time"
TOKEN_URL="http://169.254.169.254/latest/api/token"

log() {
    echo "[concourse-worker-spot-watch] $*" | systemd-cat -t concourse-worker-spot-watch -p info
}

get_imds_token() {
    curl -s -X PUT "${TOKEN_URL}" \
        -H "X-aws-ec2-metadata-token-ttl-seconds: 21600" \
        --connect-timeout 2 --max-time 5 2>/dev/null || echo ""
}

imds_status() {
    local url="$1"
    local token="$2"
    if [ -n "${token}" ]; then
        curl -s -o /dev/null -w "%{http_code}" \
            -H "X-aws-ec2-metadata-token: ${token}" \
            --connect-timeout 2 --max-time 5 \
            "${url}" 2>/dev/null || echo "000"
    else
        curl -s -o /dev/null -w "%{http_code}" \
            --connect-timeout 2 --max-time 5 \
            "${url}" 2>/dev/null || echo "000"
    fi
}

handle_interruption() {
    log "Spot interruption notice detected — initiating graceful worker retirement"
    /usr/local/bin/concourse-worker-drain
    log "Drain complete; waiting for OS shutdown"
    sleep infinity
}

log "Starting spot interruption watch (poll interval: ${POLL_INTERVAL}s)"

while true; do
    TOKEN=$(get_imds_token)

    # The endpoint stays 200 once set, so log it only the first time.
    if [ -z "${REBALANCE_SEEN:-}" ] && \
       [ "$(imds_status "${REBALANCE_URL}" "${TOKEN}")" = "200" ]; then
        log "EC2 rebalance recommendation received; not acting on it"
        REBALANCE_SEEN=1
    fi

    if [ "$(imds_status "${TERMINATION_TIME_URL}" "${TOKEN}")" = "200" ]; then
        handle_interruption
    fi

    sleep "${POLL_INTERVAL}"
done
