#!/usr/bin/env python3
"""List the GitHub Actions secrets configured on every repo in an org.

Enumerates all repositories in the organization, then queries each repo's
Actions secrets endpoint and reports the secret names (values are never
retrievable via the API). Uses the `gh` CLI for authentication, so run
`gh auth login` first. Listing a repo's secrets requires admin access to
that repo; repos where access is denied are reported separately rather
than failing the run.
"""

import json
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from typing import Annotated, Any

import cyclopts

app = cyclopts.App(
    help="List the names of all GitHub Actions secrets in every repo of an org."
)


def _gh_api(path: str, jq: str) -> list[str]:
    result = subprocess.run(  # noqa: S603
        ["gh", "api", "--paginate", path, "--jq", jq],  # noqa: S607
        capture_output=True,
        text=True,
        check=True,
    )
    return [line for line in result.stdout.splitlines() if line]


def _list_repos(org: str, *, include_archived: bool) -> list[str]:
    jq = ".[] | [.name, .archived] | @tsv"
    repos = []
    for line in _gh_api(f"orgs/{org}/repos", jq):
        name, archived = line.split("\t")
        if archived == "true" and not include_archived:
            continue
        repos.append(name)
    return sorted(repos)


def _list_secrets(org: str, repo: str) -> dict[str, Any]:
    try:
        names = _gh_api(f"repos/{org}/{repo}/actions/secrets", ".secrets[].name")
    except subprocess.CalledProcessError as exc:
        return {"repo": repo, "secrets": [], "error": exc.stderr.strip()}
    return {"repo": repo, "secrets": names, "error": None}


@app.default
def list_secrets(
    org: str = "mitodl",
    *,
    include_archived: Annotated[
        bool, cyclopts.Parameter(help="Include archived repositories.")
    ] = False,
    include_empty: Annotated[
        bool, cyclopts.Parameter(help="Also list repos that have no secrets.")
    ] = False,
    match: Annotated[
        str | None,
        cyclopts.Parameter(help="Only report secret names matching this regex."),
    ] = None,
    output_json: Annotated[
        bool, cyclopts.Parameter(name="--json", help="Emit JSON instead of text.")
    ] = False,
    concurrency: int = 10,
) -> None:
    """List the names of all Actions secrets for each repo in the org."""
    pattern = re.compile(match, re.IGNORECASE) if match else None
    repos = _list_repos(org, include_archived=include_archived)
    print(f"Scanning {len(repos)} repositories in {org}...", file=sys.stderr)

    with ThreadPoolExecutor(max_workers=concurrency) as pool:
        results = list(pool.map(lambda repo: _list_secrets(org, repo), repos))

    if pattern:
        for result in results:
            result["secrets"] = [s for s in result["secrets"] if pattern.search(s)]

    denied = [r for r in results if r["error"]]
    reportable = [
        r for r in results if not r["error"] and (r["secrets"] or include_empty)
    ]

    if output_json:
        print(json.dumps(results, indent=2))
        return

    for result in reportable:
        print(f"{result['repo']}:")
        for name in result["secrets"]:
            print(f"  {name}")

    total = sum(len(r["secrets"]) for r in reportable)
    print(
        f"\n{total} secrets across {sum(1 for r in reportable if r['secrets'])} repos",
        file=sys.stderr,
    )
    if denied:
        print(
            f"Could not list secrets for {len(denied)} repos (admin access "
            f"required): {', '.join(r['repo'] for r in denied)}",
            file=sys.stderr,
        )


if __name__ == "__main__":
    app()
