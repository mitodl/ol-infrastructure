#!/usr/bin/env python3
"""Report which Google APIs each GCP project actually calls, and by which credential.

Why this exists: retiring a GCP credential safely needs three signals, and the
first two are misleading on their own.

  1. Key age            -- worthless. A 2017 key that ran six days ago is normal
                           in a shop with no rotation policy.
  2. Last authentication-- better, but it measures *token minting*, which
                           succeeds even when every downstream API call fails.
                           It produced a five-account "zombie cohort" of
                           Universal Analytics credentials that authenticate
                           daily and do no work.
  3. API request count  -- decisive. Names the API, the RPC, the response codes,
                           and the exact credential. That is what this reports.

It reads `serviceruntime.googleapis.com/api/request_count` from Cloud
Monitoring, which is collected automatically. Do NOT reach for `gcloud logging
read` instead: data-access audit logs are off by default and the Cloud Logging
API is not even enabled on most legacy projects, so it returns nothing useful.

Credentials are reported as Monitoring returns them and then resolved to
human names where possible:
  serviceaccount:<uniqueId>          -> the SA email
  apikey:<uid>                       -> the API key display name
  oauth2:<project-number>-<hash>...  -> left as-is; the numeric prefix is the
                                        OWNING project's number, which is the
                                        only programmatic handle on a generic
                                        OAuth client.

CAVEAT THAT MUST NOT BE FORGOTTEN: positive traffic is proof of a live
consumer; ZERO traffic is not proof of death. Cloud Storage in particular does
not report caller-side request_count the way Sheets/Drive/YouTube/BigQuery do,
so a GCS-only consumer is invisible here. Treat an empty report as
"unconfirmed", never as "safe to delete".

It also watches for NEW credentials in the legacy projects (`snapshot` and
`diff`), because the estate kept growing after the inventory that was meant to
freeze it: five reCAPTCHA keys were created in it in 2026 alone. `diff`
compares service accounts, user-managed service-account keys, API keys and
reCAPTCHA keys against a committed baseline and exits non-zero when one
appears. Generic OAuth clients are not covered, because Google has no API that
lists them.

Usage:
    bin/gcp-credential-usage report PROJECT [PROJECT ...]
    bin/gcp-credential-usage report --days 90 mit-open mitxpro
    bin/gcp-credential-usage report --json --all-projects
    bin/gcp-credential-usage last-auth PROJECT [PROJECT ...]
    bin/gcp-credential-usage diff --all-projects --since 2026-08-10
    bin/gcp-credential-usage snapshot --all-projects --output BASELINE

Auth: uses the active gcloud account's access token. `report` needs only
project-level read (monitoring.timeSeries.list); `diff` and `snapshot` need
roles/iam.securityReviewer on each project. Pick the identity that can see the
legacy projects before running -- `gcloud config set account ...`.

Background: docs/plans/gcp-service-account-consumer-map.md
"""

import hashlib
import json
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from collections.abc import Callable
from datetime import UTC, date, datetime, timedelta
from enum import StrEnum
from pathlib import Path
from typing import Annotated, Any, TypedDict

import cyclopts

app = cyclopts.App(
    help=(
        "Report GCP API traffic by credential, to decide what is safe to retire, "
        "and watch the legacy projects for newly created credentials."
    )
)

MONITORING_ROOT = "https://monitoring.googleapis.com/v3"
REQUEST_COUNT_METRIC = "serviceruntime.googleapis.com/api/request_count"
IAM_ROOT = "https://iam.googleapis.com/v1"
APIKEYS_ROOT = "https://apikeys.googleapis.com/v2"  # pragma: allowlist secret
RECAPTCHA_ROOT = "https://recaptchaenterprise.googleapis.com/v1"
SERVICEUSAGE_ROOT = "https://serviceusage.googleapis.com/v1"
RECAPTCHA_SERVICE = "recaptchaenterprise.googleapis.com"
DEFAULT_BASELINE = (
    Path(__file__).resolve().parent.parent
    / "src/ol_infrastructure/infrastructure/gcp/legacy-credential-baseline.json"
)
EXIT_NEW_CREDENTIALS = 1
EXIT_UNREADABLE = 2


def _access_token() -> str:
    return subprocess.run(
        ["gcloud", "auth", "print-access-token"],  # noqa: S607
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()


def _gcloud_values(args: list[str]) -> list[list[str]]:
    """Run a gcloud command with --format=value(...) and split the TSV rows."""
    result = subprocess.run(args, capture_output=True, text=True, check=False)  # noqa: S603
    if result.returncode != 0:
        return []
    return [line.split("\t") for line in result.stdout.splitlines() if line.strip()]


def _targets(projects: list[str], all_projects: bool) -> list[str]:
    """Named projects, plus every project the active account can list if asked."""
    visible = (
        [
            row[0]
            for row in _gcloud_values(
                ["gcloud", "projects", "list", "--format=value(projectId)"]
            )
        ]
        if all_projects
        else []
    )
    return list(dict.fromkeys([*projects, *visible]))


def _get_json(
    url: str, token: str, params: dict[str, Any] | None = None
) -> dict[str, Any]:
    query = f"?{urllib.parse.urlencode(params, doseq=True)}" if params else ""
    request = urllib.request.Request(  # noqa: S310
        url + query, headers={"Authorization": f"Bearer {token}"}
    )
    with urllib.request.urlopen(request) as response:  # noqa: S310
        return json.load(response)


def _list_all(
    url: str, token: str, field: str, params: dict[str, Any] | None = None
) -> list[dict[str, Any]]:
    """Follow nextPageToken until a Google list call is exhausted."""
    items: list[dict[str, Any]] = []
    query = dict(params or {})
    while True:
        payload = _get_json(url, token, query)
        items.extend(payload.get(field, []))
        if not payload.get("nextPageToken"):
            return items
        query["pageToken"] = payload["nextPageToken"]


def _http_error_message(error: urllib.error.HTTPError) -> str:
    try:
        message = json.load(error)["error"]["message"]
    except (json.JSONDecodeError, KeyError, TypeError):
        message = str(error.reason)
    return f"HTTP {error.code}: {message.splitlines()[0][:160]}"


def _credential_names(project: str) -> dict[str, str]:
    """Map Monitoring credential_id values to human-readable names."""
    names: dict[str, str] = {}
    for row in _gcloud_values(
        [
            "gcloud",
            "iam",
            "service-accounts",
            "list",
            f"--project={project}",
            "--format=value(uniqueId,email)",
        ]
    ):
        if len(row) >= 2:
            names[f"serviceaccount:{row[0]}"] = row[1]
    for row in _gcloud_values(
        [
            "gcloud",
            "services",
            "api-keys",
            "list",
            f"--project={project}",
            "--format=value(uid,displayName,createTime)",
        ]
    ):
        if len(row) >= 2:
            created = f" created {row[2][:10]}" if len(row) > 2 else ""
            names[f"apikey:{row[0]}"] = f'API key "{row[1]}"{created}'
    return names


def _fetch_series(
    project: str, token: str, start: datetime, end: datetime
) -> list[dict[str, Any]]:
    window_seconds = int((end - start).total_seconds())
    params = {
        "filter": f'metric.type="{REQUEST_COUNT_METRIC}"',
        "interval.startTime": start.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "interval.endTime": end.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "aggregation.alignmentPeriod": f"{window_seconds}s",
        "aggregation.perSeriesAligner": "ALIGN_SUM",
        "aggregation.crossSeriesReducer": "REDUCE_SUM",
        "aggregation.groupByFields": [
            "resource.label.service",
            "resource.label.credential_id",
            "resource.label.method",
            "metric.label.response_code",
        ],
        "view": "FULL",
    }
    return _get_json(
        f"{MONITORING_ROOT}/projects/{project}/timeSeries", token, params
    ).get("timeSeries", [])


def _rows_for(
    project: str, token: str, start: datetime, end: datetime
) -> list[dict[str, Any]]:
    series = _fetch_series(project, token, start, end)
    if not series:
        return []
    names = _credential_names(project)
    rows = []
    for entry in series:
        labels = entry["resource"]["labels"]
        credential = labels.get("credential_id", "")
        rows.append(
            {
                "project": project,
                "count": sum(
                    int(point["value"].get("int64Value", 0))
                    for point in entry.get("points", [])
                ),
                "api": labels.get("service", "?"),
                "credential": credential,
                "credential_name": names.get(credential, credential or "(none)"),
                "method": labels.get("method", "?"),
                "response_code": entry["metric"]["labels"].get("response_code", "?"),
            }
        )
    return sorted(rows, key=lambda row: row["count"], reverse=True)


@app.command
def report(
    projects: Annotated[
        list[str] | None, cyclopts.Parameter(help="Project IDs to inspect.")
    ] = None,
    *,
    days: Annotated[
        int, cyclopts.Parameter(help="Window size in days, ending now.")
    ] = 30,
    all_projects: Annotated[
        bool,
        cyclopts.Parameter(help="Inspect every project the active account can list."),
    ] = False,
    as_json: Annotated[
        bool, cyclopts.Parameter(name=["--json"], help="Emit JSON instead of text.")
    ] = False,
    min_count: Annotated[
        int, cyclopts.Parameter(help="Hide rows below this call count.")
    ] = 1,
) -> None:
    """Report API calls per project, grouped by API, credential, method and status."""
    targets = _targets(projects or [], all_projects)
    if not targets:
        sys.exit("Give at least one project, or pass --all-projects.")

    token = _access_token()
    end = datetime.now(UTC).replace(microsecond=0)
    start = end - timedelta(days=days)

    everything: list[dict[str, Any]] = []
    for project in targets:
        try:
            rows = [
                row
                for row in _rows_for(project, token, start, end)
                if row["count"] >= min_count
            ]
        except urllib.error.HTTPError as error:
            if as_json:
                everything.append({"project": project, "error": str(error)})
            else:
                print(f"=== {project}\n  ERROR: {error}")
            continue

        everything.extend(rows)
        if as_json:
            continue
        print(f"=== {project}")
        if not rows:
            print("  (no API traffic recorded -- UNCONFIRMED, not proof of death)")
            continue
        for row in rows:
            print(
                f"  {row['count']:>9}  {row['api']:<32} "
                f"{row['credential_name']:<52} {row['method']:<44} "
                f"http={row['response_code']}"
            )

    if as_json:
        print(
            json.dumps(
                {
                    "window": {
                        "start": start.isoformat(),
                        "end": end.isoformat(),
                        "days": days,
                    },
                    "rows": everything,
                },
                indent=2,
            )
        )


@app.command
def last_auth(
    projects: Annotated[list[str], cyclopts.Parameter(help="Project IDs to inspect.")],
) -> None:
    """Report service-account last-authentication times (the weaker signal).

    Useful as a regression check during a migration: re-run it and see which
    timestamps advance. Requires policyanalyzer.googleapis.com on each project.
    Remember this ticks on token minting alone -- pair it with `report` before
    concluding a credential does real work.
    """
    for project in projects:
        print(f"=== {project}")
        rows = _gcloud_values(
            [
                "gcloud",
                "policy-intelligence",
                "query-activity",
                "--activity-type=serviceAccountLastAuthentication",
                f"--project={project}",
                f"--billing-project={project}",
                "--format=value(activity.lastAuthenticatedTime,fullResourceName)",
            ]
        )
        if not rows:
            print("  (no data -- is policyanalyzer.googleapis.com enabled?)")
            continue
        for row in rows:
            when = row[0] if row[0] else "never"
            account = row[-1].rsplit("/", 1)[-1]
            print(f"  {when:<22} {account}")


@app.command
def quota(
    projects: Annotated[list[str], cyclopts.Parameter(help="Project IDs to inspect.")],
    *,
    service: Annotated[
        str, cyclopts.Parameter(help="Service to report daily quota for.")
    ] = "youtube.googleapis.com",
    metric: Annotated[
        str | None,
        cyclopts.Parameter(help="Quota metric; defaults to '<service>/default'."),
    ] = None,
) -> None:
    """Compare each project's effective daily quota against Google's default.

    An effective limit above the default means someone went through Google's
    audited quota-increase process for that project. Those grants do NOT move
    with a resource and cannot be transferred into a consolidated project --
    run this BEFORE planning any consolidation, and re-request the increase
    ahead of the move, because the review is slow.

    An effective limit of 0 means the project cannot call the API at all,
    which is a far better explanation for "no traffic" than "nobody uses it".
    """
    metric_name = metric or f"{service}/default"
    for project in projects:
        result = subprocess.run(  # noqa: S603
            [  # noqa: S607
                "gcloud",
                "alpha",
                "services",
                "quota",
                "list",
                f"--service={service}",
                f"--consumer=projects/{project}",
                f"--filter=metric:{metric_name}",
                "--format=json",
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        try:
            metrics = json.loads(result.stdout)
        except json.JSONDecodeError:
            print(f"{project:<26} ERROR {result.stderr.strip()[:70]}")
            continue

        for entry in metrics:
            for limit in entry.get("consumerQuotaLimits", []):
                if limit.get("unit") != "1/d/{project}":
                    continue
                for bucket in limit.get("quotaBuckets", []):
                    effective = int(bucket.get("effectiveLimit", 0))
                    default = int(bucket.get("defaultLimit", 0))
                    note = ""
                    if effective > default:
                        ratio = effective // max(default, 1)
                        note = f"  <== GRANTED INCREASE ({ratio}x) - NON-TRANSFERABLE"
                    elif effective < default:
                        note = "  <== REDUCED - project may be unable to call the API"
                    print(
                        f"{project:<26} effective={effective:>8}/day  "
                        f"default={default:>8}/day{note}"
                    )


class CredentialKind(StrEnum):
    """Credential types `diff` can enumerate. OAuth clients cannot be listed."""

    SERVICE_ACCOUNT = "service_account"
    SERVICE_ACCOUNT_KEY = "service_account_key"  # pragma: allowlist secret
    API_KEY = "api_key"  # pragma: allowlist secret
    RECAPTCHA_KEY = "recaptcha_key"


class Credential(TypedDict):
    """One credential, identified without any key material."""

    project: str
    kind: str
    id: str
    display_name: str
    # None for service accounts: the IAM API does not expose when one was made,
    # so a new service account is caught by its absence from the baseline only.
    create_time: str | None


class ProjectInventory(TypedDict):
    """Credentials found in one project, plus the reads that failed."""

    project: str
    credentials: list[Credential]
    errors: dict[str, str]
    recaptcha_checked: bool


def _fingerprint(value: str) -> str:
    """Stable handle for an identifier that is itself key material.

    A reCAPTCHA key's resource name ends in its site key. The site key is
    public by design, but it is still the key, so the baseline and the report
    carry a digest instead.
    """
    return hashlib.sha256(value.encode()).hexdigest()[:16]


def _service_accounts(project: str, token: str) -> list[Credential]:
    found: list[Credential] = []
    accounts = _list_all(
        f"{IAM_ROOT}/projects/{project}/serviceAccounts",
        token,
        "accounts",
        {"pageSize": 100},
    )
    for account in accounts:
        email = account["email"]
        found.append(
            Credential(
                project=project,
                kind=CredentialKind.SERVICE_ACCOUNT,
                id=email,
                display_name=account.get("displayName", ""),
                create_time=None,
            )
        )
        # The list response carries key ids and validity only, never key
        # material. System-managed keys are Google's own rotation and are
        # skipped; a user-managed key is a downloadable credential.
        keys = _get_json(
            f"{IAM_ROOT}/projects/{project}/serviceAccounts/{email}/keys",
            token,
            {"keyTypes": "USER_MANAGED"},
        ).get("keys", [])
        found.extend(
            Credential(
                project=project,
                kind=CredentialKind.SERVICE_ACCOUNT_KEY,
                id=f"{email}/{key['name'].rsplit('/', 1)[-1]}",
                display_name=email,
                create_time=key["validAfterTime"],
            )
            for key in keys
        )
    return found


def _api_keys(project: str, token: str) -> list[Credential]:
    keys = _list_all(
        f"{APIKEYS_ROOT}/projects/{project}/locations/global/keys",
        token,
        "keys",
        {"pageSize": 300},
    )
    return [
        Credential(
            project=project,
            kind=CredentialKind.API_KEY,
            id=key["uid"],
            display_name=key.get("displayName", ""),
            create_time=key["createTime"],
        )
        for key in keys
    ]


def _recaptcha_keys(project: str, token: str) -> list[Credential]:
    keys = _list_all(
        f"{RECAPTCHA_ROOT}/projects/{project}/keys", token, "keys", {"pageSize": 100}
    )
    found: list[Credential] = []
    for key in keys:
        domains = key.get("webSettings", {}).get("allowedDomains", [])
        label = key.get("displayName", "")
        found.append(
            Credential(
                project=project,
                kind=CredentialKind.RECAPTCHA_KEY,
                id=_fingerprint(key["name"]),
                display_name=f"{label} [{', '.join(domains)}]" if domains else label,
                create_time=key["createTime"],
            )
        )
    return found


def _enabled_services(project: str, token: str) -> set[str]:
    services = _list_all(
        f"{SERVICEUSAGE_ROOT}/projects/{project}/services",
        token,
        "services",
        {"filter": "state:ENABLED", "pageSize": 200},
    )
    return {service["name"].rsplit("/", 1)[-1] for service in services}


InventoryReader = Callable[[str, str], list[Credential]]


def _project_inventory(project: str, token: str) -> ProjectInventory:
    """Inventory one project; a read failure is recorded per kind, not raised."""
    inventory = ProjectInventory(
        project=project, credentials=[], errors={}, recaptcha_checked=False
    )
    readers: dict[str, InventoryReader] = {
        CredentialKind.SERVICE_ACCOUNT: _service_accounts,
        CredentialKind.API_KEY: _api_keys,
    }
    # reCAPTCHA keys can only be listed through the Enterprise API, which
    # answers 403 SERVICE_DISABLED on a project that has not enabled it. Ask
    # first so a disabled API reads as "not checked" rather than as an error,
    # and never enable it from here.
    try:
        if RECAPTCHA_SERVICE in _enabled_services(project, token):
            readers[CredentialKind.RECAPTCHA_KEY] = _recaptcha_keys
            inventory["recaptcha_checked"] = True
    except urllib.error.HTTPError as error:
        inventory["errors"]["enabled_services"] = _http_error_message(error)
    for kind, reader in readers.items():
        try:
            inventory["credentials"].extend(reader(project, token))
        except urllib.error.HTTPError as error:
            inventory["errors"][kind] = _http_error_message(error)
    return inventory


def _credential_key(credential: Credential) -> tuple[str, str, str]:
    return (credential["project"], credential["kind"], credential["id"])


def _sorted_credentials(credentials: list[Credential]) -> list[Credential]:
    return sorted(credentials, key=_credential_key)


@app.command
def snapshot(
    projects: Annotated[
        list[str] | None, cyclopts.Parameter(help="Project IDs to inventory.")
    ] = None,
    *,
    all_projects: Annotated[
        bool,
        cyclopts.Parameter(help="Inventory every project the active account can list."),
    ] = False,
    output: Annotated[
        Path | None,
        cyclopts.Parameter(help="Write the baseline here instead of to stdout."),
    ] = None,
) -> None:
    """Write the current credential inventory as a baseline for `diff`.

    Records service accounts, user-managed service-account keys, API keys and
    reCAPTCHA keys with their creation times. No key material: API keys are
    recorded by uid, service-account keys by key id, and reCAPTCHA keys by a
    digest of their resource name. Generic OAuth clients are not recorded,
    because Google has no API that lists them.

    Refuses to write anything when a project cannot be read in full. A partial
    baseline would make every later `diff` report the missing credentials as
    new.
    """
    targets = _targets(projects or [], all_projects)
    if not targets:
        sys.exit("Give at least one project, or pass --all-projects.")

    token = _access_token()
    inventories = [_project_inventory(project, token) for project in targets]
    failures = {inv["project"]: inv["errors"] for inv in inventories if inv["errors"]}
    if failures:
        sys.exit(
            "Not writing a baseline; these reads failed:\n"
            + json.dumps(failures, indent=2)
        )

    baseline = {
        "as_of": datetime.now(UTC).date().isoformat(),
        "projects": sorted(targets),
        "credentials": _sorted_credentials(
            [credential for inv in inventories for credential in inv["credentials"]]
        ),
    }
    text = json.dumps(baseline, indent=2) + "\n"
    if output:
        output.write_text(text)
    else:
        sys.stdout.write(text)


def _describe(credential: Credential) -> str:
    created = (credential["create_time"] or "")[:10] or "unknown"
    return (
        f"{credential['kind']:<20} created {created:<10}  "
        f'"{credential["display_name"]}"  id={credential["id"]}'
    )


@app.command
def diff(
    projects: Annotated[
        list[str] | None,
        cyclopts.Parameter(
            help="Project IDs to check. Defaults to the projects in the baseline."
        ),
    ] = None,
    *,
    all_projects: Annotated[
        bool,
        cyclopts.Parameter(
            help=(
                "Also check every project the active account can list, so a "
                "new legacy project is caught too."
            )
        ),
    ] = False,
    baseline: Annotated[
        Path, cyclopts.Parameter(help="Baseline written by `snapshot`.")
    ] = DEFAULT_BASELINE,
    since: Annotated[
        date | None,
        cyclopts.Parameter(
            help=(
                "Also flag credentials created on or after this date, even when "
                "the baseline already lists them."
            )
        ),
    ] = None,
    as_json: Annotated[
        bool, cyclopts.Parameter(name=["--json"], help="Emit JSON instead of text.")
    ] = False,
) -> None:
    """Report credentials that are absent from the baseline or created after --since.

    Covers service accounts, user-managed service-account keys, API keys and
    reCAPTCHA keys. reCAPTCHA keys are listed only where
    recaptchaenterprise.googleapis.com is already enabled; this never enables
    an API, and a project without it is reported as not checked rather than as
    clean. Generic OAuth 2.0 clients are NOT covered: Google has no API that
    lists them, so a new one can only be found in the Console.

    A service account has no creation time in the IAM API, so a new one is
    caught by its absence from the baseline, never by --since.

    Credentials in the baseline that no longer exist are listed as GONE. That
    is informational: refresh the baseline with `snapshot`.

    Exit status: 1 when anything new is found, otherwise 2 when any project or
    credential type could not be read, otherwise 0.

    Needs roles/iam.securityReviewer on each project. It carries every list
    permission used here and, unlike roles/viewer, not
    apikeys.keys.getKeyString.
    """
    recorded = json.loads(baseline.read_text())
    targets = _targets(projects or recorded["projects"], all_projects)
    known = {_credential_key(credential) for credential in recorded["credentials"]}
    cutoff = since.isoformat() if since else None

    token = _access_token()
    results: list[dict[str, Any]] = []
    for project in targets:
        inventory = _project_inventory(project, token)
        current = {_credential_key(c) for c in inventory["credentials"]}
        new = []
        for credential in _sorted_credentials(inventory["credentials"]):
            reasons = []
            if _credential_key(credential) not in known:
                reasons.append("not in baseline")
            if cutoff and (credential["create_time"] or "") >= cutoff:
                reasons.append(f"created on/after {cutoff}")
            if reasons:
                new.append({**credential, "reasons": reasons})
        gone = [
            credential
            for credential in _sorted_credentials(recorded["credentials"])
            if credential["project"] == project
            and _credential_key(credential) not in current
            # A kind that failed to read is not evidence of deletion.
            and credential["kind"] not in inventory["errors"]
            and (
                credential["kind"] != CredentialKind.RECAPTCHA_KEY
                or inventory["recaptcha_checked"]
            )
        ]
        results.append(
            {
                "project": project,
                "new": new,
                "gone": gone,
                "errors": inventory["errors"],
                "recaptcha_checked": inventory["recaptcha_checked"],
            }
        )

    if as_json:
        print(
            json.dumps(
                {"baseline": str(baseline), "since": cutoff, "projects": results},
                indent=2,
            )
        )
    else:
        quiet = []
        for result in results:
            if not (result["new"] or result["gone"] or result["errors"]):
                quiet.append(result["project"])
                continue
            print(f"=== {result['project']}")
            for credential in result["new"]:
                print(
                    f"  NEW   {_describe(credential)}  ({'; '.join(credential['reasons'])})"
                )
            for credential in result["gone"]:
                print(f"  GONE  {_describe(credential)}")
            for kind, error in result["errors"].items():
                print(f"  ERROR {kind}: {error}")
        if quiet:
            print(f"Nothing new in: {', '.join(quiet)}")
        unchecked = [
            r["project"]
            for r in results
            if not r["recaptcha_checked"] and "enabled_services" not in r["errors"]
        ]
        if unchecked:
            print(
                f"reCAPTCHA not checked ({RECAPTCHA_SERVICE} not enabled): "
                + ", ".join(unchecked)
            )
        print("OAuth clients not checked: Google has no API that lists them.")

    if any(result["new"] for result in results):
        sys.exit(EXIT_NEW_CREDENTIALS)
    if any(result["errors"] for result in results):
        sys.exit(EXIT_UNREADABLE)


if __name__ == "__main__":
    app()
