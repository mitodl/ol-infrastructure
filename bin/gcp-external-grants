#!/usr/bin/env python3
"""Enumerate the external Google-product grants held by a GCP credential.

Why this exists: a GCP service account, API key or reCAPTCHA key CANNOT be moved
between projects -- no API exists for it. Consolidating a credential therefore
means creating a *replacement*, which yields a new service-account email or a new
key string, and every grant that named the old identity has to be re-issued by
hand. So no credential can be re-homed until its external grants are known.

The received wisdom -- recorded in the consumer map and in the task that gates
this work -- was that these grants cannot be enumerated programmatically, only
walked product-by-product in each product's admin UI. That is half right. No
*GCP* API can find them, because the grants do not live in GCP: they live in
Drive, Sheets, Analytics, BigQuery and YouTube. But each of those products has an
API that answers "what can I see?" when you ask it AS THE CREDENTIAL ITSELF.
That inverts the problem from "audit every product" to "mint one token per
credential and ask five questions".

What it asks, per credential:

  drive.drives.list        -- Shared Drives the credential is a member of
  drive.files.list         -- individual files/folders shared with it, including
                              items resident in Shared Drives it can reach
  analyticsadmin           -- GA4 account/property summaries it can read
  bigquery.projects.list   -- EVERY project it holds BigQuery access in,
                              including projects owned by third parties. This is
                              the one that finds grants nobody on this side
                              issued and nobody on this side can re-issue.
  youtube.channels.list    -- channels the credential is authorised against
                              (meaningful for OAuth clients; usually empty for a
                              bare service account)

Effective access is read from each item's `capabilities`, not from
`permissions.list`. `capabilities` comes back inline with the listing, so it
costs no extra call per item, and it reports what this credential can actually
do -- including access inherited from a folder or arriving via a group, which a
permission entry naming the credential would not show. (`permissions.list` is
also believed to require more than reader on the item, which would make it fail
exactly where the answer matters most, but that has not been confirmed here.)

CAVEATS, which decide how the output may be used:

  * ABSENCE IS NOT PROOF. A grant made to a Google *group* the credential belongs
    to, or one revoked-then-restored, can be missed. Read an empty result as
    "nothing found", never as "nothing exists" -- the same error that key-age
    triage made on this estate twice.
  * GCS IS NOT COVERED. There is no cross-project "list buckets I can read" API.
    A bucket grant is invisible here and has to be confirmed against the
    consumer's own configuration.
  * QUOTA IS NOT A GRANT. A granted quota increase attaches to the PROJECT and
    does not follow a consumer anywhere. It will never appear in this output and
    must not be conflated with the grants that do. See `gcp-credential-usage
    quota`.

Read-only: every call this makes is a GET. It never prints, logs or writes
credential material -- only the `client_email` the credential already publishes.

Usage:
    bin/gcp-external-grants probe --key-file sa.json
    bin/gcp-external-grants probe --vault secret-xpro/google-sheets:service_account_creds
    bin/gcp-external-grants probe --vault secret-data/pipelines/google-service-account
    bin/gcp-external-grants scopes          # what each probe needs, and why

Vault: reads VAULT_ADDR and VAULT_TOKEN (or ~/.vault-token) via hvac. KV v1 and
v2 mounts are both handled without being told which is which -- this estate runs
both. `--vault MOUNT/PATH:FIELD` takes the SA JSON from one field (dotted for a
nested one, e.g. `...:google.drive_service_json`); `--vault MOUNT/PATH` with no
field treats the whole secret body as the SA JSON, which is how the Dagster
credentials are stored.

Background: docs/plans/gcp-service-account-consumer-map.md
            docs/plans/gcp-external-grant-register.md
"""

import functools
import json
import os
import subprocess
import sys
import time
from collections.abc import Callable
from pathlib import Path
from typing import Annotated, Any

import cyclopts
import hvac
import jwt
import requests

app = cyclopts.App(
    help="Enumerate the external Google-product grants held by a GCP credential."
)

TOKEN_URL = "https://oauth2.googleapis.com/token"  # noqa: S105
JWT_BEARER = "urn:ietf:params:oauth:grant-type:jwt-bearer"
TIMEOUT = 60

# Every scope here is read-only. Widening this list widens what a leaked token
# from this tool could do, so keep it minimal and keep it readonly.
SCOPES = (
    "https://www.googleapis.com/auth/drive.readonly",
    "https://www.googleapis.com/auth/analytics.readonly",
    "https://www.googleapis.com/auth/cloud-platform.read-only",
    "https://www.googleapis.com/auth/youtube.readonly",
)

# Email domains OL controls, matched on the domain and its subdomains. A share
# from outside them is a grant we cannot re-issue on our own timeline -- the
# distinction the migration plan turns on. Service-account addresses are NOT
# covered by this: see _is_third_party_email.
OWNED_DOMAINS = ("mit.edu",)


class ProbeError(Exception):
    """A probe could not run. Reported per-probe; never aborts the whole run."""


def _load_key_file(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text())


def _read_vault_secret(
    client: "hvac.Client", mount: str, subpath: str
) -> dict[str, Any]:
    """Read a KV secret without being told which KV version the mount is.

    This estate runs both: `secret-ocw-studio` is v2 while `secret-xpro` and
    `secret-data` are v1. Requiring the caller to know which is which is a
    footgun for a tool whose whole point is to be pointed at arbitrary
    credentials, so try v2 and fall back.
    """
    try:
        return client.secrets.kv.v2.read_secret_version(
            path=subpath, mount_point=mount, raise_on_deleted_version=False
        )["data"]["data"]
    except (hvac.exceptions.VaultError, KeyError):
        return client.secrets.kv.v1.read_secret(path=subpath, mount_point=mount)["data"]


def _extract_key(data: dict[str, Any], field: str) -> dict[str, Any]:
    """Pull the service-account JSON out of a secret body.

    Three shapes occur in this estate and all three have to work:

      no field      the whole secret body IS the SA JSON, one Vault field per
                    JSON key (Dagster `canvas`, and the edxorg credential,
                    which additionally spells `auth_uri`/`client_x509_cert_url`
                    as `url`/`cert_url` -- harmless here, since signing needs
                    only `client_email` and `private_key`)
      "field"       one field holding the JSON as a string (xPro)
      "a.b"         a nested object (OCW Studio: `google` -> `drive_service_json`)
    """
    if not field:
        return data
    value: Any = data
    for part in field.split("."):
        if not isinstance(value, dict) or part not in value:
            available = ", ".join(sorted(value)) if isinstance(value, dict) else "?"
            message = f"no {part!r} in secret (has: {available})"
            raise ProbeError(message)
        value = value[part]
    return json.loads(value) if isinstance(value, str) else value


def _normalise_private_key(key: dict[str, Any]) -> dict[str, Any]:
    """Un-escape a PEM stored with literal backslash-n.

    At least the Dagster `canvas` credential is stored that way -- its consumer
    does the same replace before handing it to google-auth. Left as-is, the PEM
    does not parse and the failure surfaces as an opaque signing error rather
    than as "this secret is escaped".
    """
    private = key.get("private_key")
    if isinstance(private, str) and "\\n" in private:
        return {**key, "private_key": private.replace("\\n", "\n")}
    return key


def _load_vault(spec: str) -> dict[str, Any]:
    """Load a service-account key from Vault. Spec is PATH or PATH:FIELD."""
    path, _, field = spec.partition(":")
    mount, _, subpath = path.partition("/")
    if not subpath:
        message = f"--vault expects MOUNT/PATH[:FIELD], got {spec!r}"
        raise ProbeError(message)
    address = os.environ.get("VAULT_ADDR")
    if not address:
        message = (
            "VAULT_ADDR is not set -- e.g. "
            "export VAULT_ADDR=https://vault-production.odl.mit.edu"
        )
        raise ProbeError(message)
    token = (
        os.environ.get("VAULT_TOKEN")
        or Path.home().joinpath(".vault-token").read_text().strip()
    )
    client = hvac.Client(url=address, token=token)
    data = _read_vault_secret(client, mount, subpath)
    return _normalise_private_key(_extract_key(data, field))


def _load_heroku(spec: str) -> dict[str, Any]:
    """Read a service-account key out of a Heroku config var.

    Needed because `ol-eng-library-platform@` -- the estate's busiest Drive
    credential -- is not in Vault at all. It reaches its three Heroku apps as a
    `GOOGLE_APPLICATION_JSON` config var and lives nowhere else.
    """
    app_name, _, variable = spec.partition(":")
    if not app_name or not variable:
        message = f"--heroku expects APP:VAR, got {spec!r}"
        raise ProbeError(message)
    result = subprocess.run(  # noqa: S603
        ["heroku", "config:get", variable, "-a", app_name],  # noqa: S607
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        message = f"heroku config:get failed: {result.stderr.strip()[:160]}"
        raise ProbeError(message)
    raw = result.stdout.strip()
    if not raw:
        message = f"{variable} is empty or unset on {app_name}"
        raise ProbeError(message)
    return json.loads(raw)


def _gcloud_token() -> tuple[str, str]:
    """Token for the active gcloud identity, for probing a human's own grants.

    Only the BigQuery probe is meaningful here: gcloud mints cloud-platform
    scope, so the Drive/Analytics/YouTube probes will report 403 regardless of
    what the human can actually see. That is a scope limit, not an answer.
    """
    token = subprocess.run(
        ["gcloud", "auth", "print-access-token"],  # noqa: S607
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
    identity = subprocess.run(
        ["gcloud", "config", "get-value", "account"],  # noqa: S607
        capture_output=True,
        text=True,
        check=False,
    ).stdout.strip()
    return token, identity or "(active gcloud account)"


def _access_token(key: dict[str, Any]) -> str:
    """Exchange a service-account key for an access token via the JWT bearer flow."""
    now = int(time.time())
    assertion = jwt.encode(
        {
            "iss": key["client_email"],
            "scope": " ".join(SCOPES),
            "aud": TOKEN_URL,
            "iat": now,
            "exp": now + 3600,
        },
        key["private_key"],
        algorithm="RS256",
    )
    response = requests.post(
        TOKEN_URL,
        data={"grant_type": JWT_BEARER, "assertion": assertion},
        timeout=TIMEOUT,
    )
    if not response.ok:
        # Google echoes the assertion back in some errors; report status only.
        message = f"token exchange failed: HTTP {response.status_code}"
        raise ProbeError(message)
    return response.json()["access_token"]


def _get(url: str, token: str, **params: Any) -> dict[str, Any]:
    response = requests.get(
        url,
        headers={"Authorization": f"Bearer {token}"},
        params=params,
        timeout=TIMEOUT,
    )
    if not response.ok:
        detail = response.json().get("error", {}) if response.content else {}
        message = (
            f"HTTP {response.status_code}: "
            f"{detail.get('message', response.reason)[:160]}"
        )
        raise ProbeError(message)
    return response.json()


UNKNOWN_PARENT = "?"


def _project_parent(project_id: str, cache: dict[str, str]) -> str:
    """Resolve the project's parent: `folder/<id>`, `organization/<id>` or `""`.

    Returns UNKNOWN_PARENT when the project cannot be described at all, which
    is itself strong evidence: a project no OL identity can even read metadata
    for is not one OL administers.
    """
    if project_id in cache:
        return cache[project_id]
    parent = UNKNOWN_PARENT
    for account in [*_gcloud_accounts(), None]:
        command = [
            "gcloud",
            "projects",
            "describe",
            project_id,
            "--format=value(parent.type,parent.id)",
        ]
        if account:
            command.append(f"--account={account}")
        result = subprocess.run(command, capture_output=True, text=True, check=False)  # noqa: S603
        if result.returncode == 0:
            fields = result.stdout.strip().split("\t")
            parent = (
                f"{fields[0]}/{fields[1]}"
                if len(fields) == 2 and fields[0] and fields[1]
                else ""
            )
            break
    cache[project_id] = parent
    return parent


class Ownership:
    """Decides whether a resource belongs to OL, from the project HIERARCHY.

    The obvious signal -- "is it in `gcloud projects list`?" -- is wrong, and
    wrong in the direction that matters. That call returns every project the
    identity can SEE, which includes third-party projects OL has been granted
    into. Those grants are the exact thing this tool exists to find, so keying
    ownership on visibility launders them into "internal" and drops them from
    the migration plan. Observed for real: `mitx-pipeline-main-dc29` sits in a
    folder no OL account can even describe, yet appears in `projects list`
    because a viewer grant was issued to us -- the grant, showing up as proof
    of ownership.

    Parentage does not have that failure mode. A project is OL's when it sits
    where OL's projects sit: the same folder/org as the credential being
    probed, or standalone in the legacy gmail estate (no parent at all, which
    is what every legacy project looks like).

    The owned parents are derived from the credential under test rather than
    from ambient gcloud state, so the verdict does not move when someone runs
    `gcloud config set account`.
    """

    def __init__(self, owned_parents: set[str], extra_projects: set[str]) -> None:
        """Hold the parents treated as OL's, plus explicitly-pinned projects."""
        self.owned_parents = owned_parents
        self.extra_projects = extra_projects
        self._cache: dict[str, str] = {}

    def parent_of(self, project_id: str) -> str:
        """Return the project's parent, cached across probes."""
        return _project_parent(project_id, self._cache)

    def classify_project(self, project_id: str) -> bool | None:
        """Report True when third party, False when OL's, None when undecidable."""
        if project_id in self.extra_projects:
            return False
        parent = self.parent_of(project_id)
        if parent == UNKNOWN_PARENT:
            # Not describable by any OL identity. We hold a grant into it and
            # nothing more, which is the definition of an external grant.
            return True
        if not self.owned_parents:
            return None
        return parent not in self.owned_parents

    def classify_email(self, address: str) -> bool | None:
        """Classify a Drive share's grantor.

        A service-account address cannot be judged by its domain: EVERY
        project's service accounts live under `*.iam.gserviceaccount.com`,
        a third party's included. The project id is embedded in the address,
        so route those through the same hierarchy check. Human addresses fall
        back to the domain.
        """
        lowered = address.lower().strip()
        _, _, domain = lowered.partition("@")
        if not domain:
            return None
        if domain.endswith(".iam.gserviceaccount.com"):
            return self.classify_project(
                domain.removesuffix(".iam.gserviceaccount.com")
            )
        return not any(
            domain == owned_domain or domain.endswith(f".{owned_domain}")
            for owned_domain in OWNED_DOMAINS
        )


def _ownership_for_run(
    keys: list[dict[str, Any]],
    extra_parents: tuple[str, ...],
    extra_projects: tuple[str, ...],
) -> Ownership:
    """Build one ownership model from every credential in this run.

    Unioned across the run, not per credential, because OL's estate legitimately
    spans two hierarchies: the legacy gmail projects (no parent at all) and the
    MIT org folder the migration targets. Judging a legacy credential against
    only its own hierarchy would report `mitol01` -- OL's own destination -- as
    a third party. Seeding from the credentials actually being probed keeps that
    correct without hardcoding a folder id, which is the stale-list failure this
    design already fell into once.
    """
    cache: dict[str, str] = {}
    owned_parents = set(extra_parents)
    for key in keys:
        home = key.get("project_id", "")
        if not home:
            continue
        parent = _project_parent(home, cache)
        if parent != UNKNOWN_PARENT:
            owned_parents.add(parent)
    model = Ownership(owned_parents, set(extra_projects))
    model._cache = cache  # noqa: SLF001
    return model


@functools.cache
def _gcloud_accounts() -> tuple[str, ...]:
    """Every account gcloud holds credentials for, active or not.

    Cached: this is consulted once per project while resolving parentage, and
    re-shelling `gcloud auth list` for each one made a 13-project run spend most
    of its wall clock in subprocess startup.
    """
    result = subprocess.run(
        ["gcloud", "auth", "list", "--format=value(account)"],  # noqa: S607
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return ()
    return tuple(line.strip() for line in result.stdout.splitlines() if line.strip())


def _projects_for_account(account: str | None) -> set[str]:
    command = ["gcloud", "projects", "list", "--format=value(projectId)"]
    if account:
        command.append(f"--account={account}")
    result = subprocess.run(command, capture_output=True, text=True, check=False)  # noqa: S603
    if result.returncode != 0:
        return set()
    return {line.strip() for line in result.stdout.splitlines() if line.strip()}


def _capability_summary(capabilities: dict[str, bool]) -> str:
    """Effective access, read from capabilities rather than permissions.list."""
    if capabilities.get("canManageMembers") or capabilities.get("canDeleteDrive"):
        return "organizer"
    if capabilities.get("canDelete") or capabilities.get("canRename"):
        return "content-manager/writer"
    if capabilities.get("canEdit"):
        return "writer"
    if capabilities.get("canComment"):
        return "commenter"
    return "reader"


def _shared_drives(token: str) -> list[dict[str, Any]]:
    """Every Shared Drive the credential is a member of."""
    drives: list[dict[str, Any]] = []
    page: str | None = None
    while True:
        payload = _get(
            "https://www.googleapis.com/drive/v3/drives",
            token,
            pageSize=100,
            fields="nextPageToken,drives(id,name,capabilities)",
            **({"pageToken": page} if page else {}),
        )
        drives.extend(payload.get("drives", []))
        page = payload.get("nextPageToken")
        if not page:
            return drives


def _probe_shared_drives(token: str, owner: Ownership) -> list[dict[str, Any]]:  # noqa: ARG001
    return [
        {
            "product": "Drive (Shared Drive)",
            "resource_id": drive["id"],
            "resource_name": drive.get("name", ""),
            "access": _capability_summary(drive.get("capabilities", {})),
            "granted_by": "Shared Drive organizer",
            "third_party": False,
        }
        for drive in _shared_drives(token)
    ]


def _probe_shared_files(token: str, owner: Ownership) -> list[dict[str, Any]]:
    drive_names = {d["id"]: d.get("name", d["id"]) for d in _shared_drives(token)}
    grants: list[dict[str, Any]] = []
    page: str | None = None
    while True:
        payload = _get(
            "https://www.googleapis.com/drive/v3/files",
            token,
            q="sharedWithMe",
            pageSize=100,
            supportsAllDrives=True,
            includeItemsFromAllDrives=True,
            fields=(
                "nextPageToken,"
                "files(id,name,mimeType,driveId,capabilities,owners(emailAddress))"
            ),
            **({"pageToken": page} if page else {}),
        )
        for item in payload.get("files", []):
            owners = [o.get("emailAddress", "") for o in item.get("owners", [])]
            grantor = owners[0] if owners else ""
            drive_id = item.get("driveId", "")
            if grantor:
                granted_by, third_party = grantor, owner.classify_email(grantor)
            elif drive_id:
                # Files inside a Shared Drive carry NO `owners` -- the drive owns
                # them. Reporting that as "unknown owner" buried real answers in
                # noise; the drive is the grantor, and one we can name.
                granted_by = f"Shared Drive {drive_names.get(drive_id, drive_id)}"
                third_party = False if drive_id in drive_names else None
            else:
                granted_by, third_party = "unknown owner", None
            grants.append(
                {
                    "product": "Drive/Sheets (direct share)",
                    "resource_id": item["id"],
                    "resource_name": f"{item.get('name', '')} [{item['mimeType']}]",
                    "access": _capability_summary(item.get("capabilities", {})),
                    "granted_by": granted_by,
                    "third_party": third_party,
                }
            )
        page = payload.get("nextPageToken")
        if not page:
            return grants


def _probe_analytics(token: str, owner: Ownership) -> list[dict[str, Any]]:  # noqa: ARG001
    payload = _get(
        "https://analyticsadmin.googleapis.com/v1beta/accountSummaries",
        token,
        pageSize=200,
    )
    return [
        {
            "product": "Google Analytics (GA4)",
            "resource_id": prop.get("property", ""),
            "resource_name": (
                f"{summary.get('displayName', '')} / {prop.get('displayName', '')}"
            ),
            "access": "read (level not exposed by accountSummaries)",
            "granted_by": "GA account administrator",
            "third_party": False,
        }
        for summary in payload.get("accountSummaries", [])
        for prop in summary.get("propertySummaries", [])
    ]


def _probe_bigquery(token: str, owner: Ownership) -> list[dict[str, Any]]:
    """Every project the credential holds BigQuery access in, ours or not.

    This is the probe that earns the tool: a third party's grant into their own
    project is otherwise discoverable only by asking them.
    """
    grants: list[dict[str, Any]] = []
    page: str | None = None
    while True:
        payload = _get(
            "https://bigquery.googleapis.com/bigquery/v2/projects",
            token,
            maxResults=100,
            **({"pageToken": page} if page else {}),
        )
        for project in payload.get("projects", []):
            project_id = project.get("id", "")
            third_party = owner.classify_project(project_id)
            parent = owner.parent_of(project_id)
            grants.append(
                {
                    "product": "BigQuery",
                    "resource_id": project_id,
                    "resource_name": project.get("friendlyName", ""),
                    "access": "project-level BigQuery access",
                    "granted_by": {
                        True: "THIRD PARTY -- re-issue needs their cooperation",
                        False: "project IAM",
                        None: "unknown -- could not resolve project parentage",
                    }[third_party],
                    "parent": (
                        "not describable by any OL identity"
                        if parent == UNKNOWN_PARENT
                        else (parent or "none (standalone legacy project)")
                    ),
                    "third_party": third_party,
                    "datasets": _datasets_in(token, project_id),
                }
            )
        page = payload.get("nextPageToken")
        if not page:
            return grants


def _datasets_in(token: str, project_id: str) -> list[str]:
    """Dataset ids the credential can see inside one project.

    Project-level enumeration alone cannot answer "what were we actually granted".
    A credential appears against a project whether it holds one dataset there or
    all of them, and for a third party's project that difference is the whole
    negotiation: re-issuing one dataset grant is a different conversation from
    re-issuing project-wide access.

    `all=true` includes hidden datasets. Failures return [] rather than raising --
    a project we can list but not enumerate is still a real grant worth reporting.
    """
    ids: list[str] = []
    page: str | None = None
    while True:
        try:
            payload = _get(
                f"https://bigquery.googleapis.com/bigquery/v2/projects/{project_id}/datasets",
                token,
                all=True,
                maxResults=200,
                **({"pageToken": page} if page else {}),
            )
        except (ProbeError, requests.RequestException):
            return ids
        ids.extend(
            entry.get("datasetReference", {}).get("datasetId", "")
            for entry in payload.get("datasets", [])
        )
        page = payload.get("nextPageToken")
        if not page:
            return [i for i in ids if i]


def _probe_youtube(token: str, owner: Ownership) -> list[dict[str, Any]]:  # noqa: ARG001
    payload = _get(
        "https://www.googleapis.com/youtube/v3/channels",
        token,
        part="id,snippet",
        mine="true",
    )
    return [
        {
            "product": "YouTube",
            "resource_id": item.get("id", ""),
            "resource_name": item.get("snippet", {}).get("title", ""),
            "access": "channel owner/manager",
            "granted_by": "YouTube channel owner",
            "third_party": False,
        }
        for item in payload.get("items", [])
    ]


Probe = Callable[[str, Ownership], list[dict[str, Any]]]

# `owner` is passed to every probe for one signature; the Drive and BigQuery
# probes consult it, the rest ignore it.
PROBES: dict[str, Probe] = {
    "shared_drives": _probe_shared_drives,
    "shared_files": _probe_shared_files,
    "analytics": _probe_analytics,
    "bigquery": _probe_bigquery,
    "youtube": _probe_youtube,
}


def _probe_one(key: dict[str, Any], owner: Ownership) -> dict[str, Any]:
    result: dict[str, Any] = {
        "credential": key.get("client_email", "(unknown)"),
        "project": key.get("project_id", ""),
        "grants": [],
        "errors": {},
    }
    if key.get("_gcloud"):
        token, result["credential"] = _gcloud_token()
    else:
        try:
            token = _access_token(key)
        except ProbeError as error:
            result["errors"]["token"] = str(error)
            return result
        except KeyError as error:
            # Most often the field holds an OAuth client, not a service-account
            # key. Those have no private key to sign an assertion with, and no
            # API can enumerate them -- say so rather than reporting a bare
            # missing-key name.
            result["errors"]["token"] = (
                f"missing {error} -- not a service-account key. Generic OAuth "
                f"clients cannot be probed; walk them in the Console."
            )
            return result
    for name, probe in PROBES.items():
        try:
            result["grants"].extend(probe(token, owner))
        except ProbeError as error:
            # A denied probe is itself information: it says this credential holds
            # nothing in that product, or was never scoped for it.
            result["errors"][name] = str(error)
        except requests.RequestException as error:
            result["errors"][name] = f"transport: {type(error).__name__}"
    return result


# The credentials this estate actually holds, in the order worth running them.
# Kept here rather than in the register so `probe-all` needs no arguments and no
# copy-paste; the register explains what each one is expected to reveal.
ESTATE: tuple[dict[str, str], ...] = (
    {
        "label": "ol-data-platform-qa@ -- edx.org third-party BigQuery grants",
        "vault": "secret-data/pipelines/edx/org/gcp-oauth-client",
    },
    {
        "label": "xpro-coupon-requests-* -- coupon/refund/deferral sheets",
        "vault": "secret-xpro/google-sheets:service_account_creds",
    },
    {
        "label": "ocw-studio -- prod or rc, WHICHEVER THIS VAULT SERVES",
        "vault": "secret-ocw-studio/collected:google.drive_service_json",
    },
    {
        "label": "ol-data-platform-production@ -- Canvas sheet + unidentified source",
        "vault": "secret-data/pipelines/google-service-account",
    },
    {
        # Found via dagster_server_policy.hcl, not via any inventory pass. If MIT
        # Institutional Research issued this from THEIR project, it is a credential
        # OL cannot re-create for itself -- the sharpest kind of external grant.
        "label": "institutional-research BigQuery SA -- owner not yet established",
        "vault": "secret-operations/institutional-research-bigquery-service-account",
    },
    {
        "label": "ol-eng-library-platform@ -- Heroku only, not in Vault",
        "heroku": "ol-eng-library:GOOGLE_APPLICATION_JSON",
    },
)

MARKDOWN_HEADER = (
    "| Credential | Product | Resource id | Resource name | Access | Grantor "
    "| Third party? | Datasets |\n|---|---|---|---|---|---|---|---|"
)

DATASET_PREVIEW = 12


def _render_datasets(datasets: list[str]) -> str:
    """Name the datasets, truncating so one wide project cannot swamp a table."""
    if not datasets:
        return "none visible"
    shown = ", ".join(datasets[:DATASET_PREVIEW])
    remainder = len(datasets) - DATASET_PREVIEW
    return f"{shown} (+{remainder} more)" if remainder > 0 else shown


def _markdown_rows(results: list[dict[str, Any]]) -> str:
    """Render findings as the register's Findings table, ready to paste."""
    third_party_label = {True: "**YES**", False: "no", None: "unknown"}
    lines = [MARKDOWN_HEADER]
    for result in results:
        for grant in sorted(result["grants"], key=lambda g: g["product"]):
            cells = [
                result["credential"],
                grant["product"],
                f"`{grant['resource_id']}`",
                grant["resource_name"] or "",
                grant["access"],
                grant["granted_by"],
                third_party_label[grant["third_party"]],
                (
                    _render_datasets(grant["datasets"])
                    if grant.get("datasets") is not None
                    else ""
                ),
            ]
            lines.append("| " + " | ".join(str(cell) for cell in cells) + " |")
        # A credential that produced nothing must still occupy a row. Pasting a
        # table where it is simply absent turns "not asked" into "asked, found
        # nothing" -- the exact conflation this whole exercise exists to avoid.
        if not result["grants"]:
            reason = (
                "; ".join(
                    f"{probe}: {error}" for probe, error in result["errors"].items()
                )
                or "no grants found"
            )
            lines.append(
                f"| {result['credential']} | **NOT ENUMERATED** | | "
                f"{reason} | | | unknown | |"
            )
    return "\n".join(lines)


def _print_report(results: list[dict[str, Any]]) -> None:
    for result in results:
        print(f"\n=== {result['credential']}  (project {result['project'] or '?'})")
        if not result["grants"]:
            print("  no grants found -- NOT proof that none exist; see caveats")
        for grant in sorted(result["grants"], key=lambda g: g["product"]):
            flag = {
                True: "  <== THIRD PARTY",
                False: "",
                None: "  <== ownership unknown",
            }[grant["third_party"]]
            print(f"  {grant['product']}")
            print(f"    id      {grant['resource_id']}")
            print(f"    name    {grant['resource_name']}")
            print(f"    access  {grant['access']}")
            print(f"    grantor {grant['granted_by']}{flag}")
            if grant.get("parent"):
                print(f"    parent  {grant['parent']}")
            datasets = grant.get("datasets")
            if datasets is not None:
                print(f"    datasets ({len(datasets)}) {_render_datasets(datasets)}")
        for probe, error in result["errors"].items():
            print(f"  [{probe}] {error}")


@app.command
def probe(
    *,
    key_file: Annotated[
        list[Path] | None,
        cyclopts.Parameter(help="Service-account JSON key file(s) to probe."),
    ] = None,
    vault: Annotated[
        list[str] | None,
        cyclopts.Parameter(help="Vault source(s) as MOUNT/PATH[:FIELD]."),
    ] = None,
    heroku: Annotated[
        list[str] | None,
        cyclopts.Parameter(help="Heroku config-var source(s) as APP:VAR."),
    ] = None,
    gcloud: Annotated[
        bool,
        cyclopts.Parameter(
            help="Also probe the active gcloud identity (BigQuery only; see docs)."
        ),
    ] = False,
    as_json: Annotated[
        bool, cyclopts.Parameter(name=["--json"], help="Emit JSON instead of text.")
    ] = False,
    markdown: Annotated[
        bool,
        cyclopts.Parameter(help="Emit the register's Findings table rows."),
    ] = False,
    owned_parent: Annotated[
        list[str] | None,
        cyclopts.Parameter(
            help="Extra parent(s) to treat as OL's, e.g. folder/551004127831."
        ),
    ] = None,
    owned_project: Annotated[
        list[str] | None,
        cyclopts.Parameter(help="Project id(s) to force-classify as OL-owned."),
    ] = None,
) -> None:
    """Enumerate external product grants for each supplied credential."""
    keys: list[dict[str, Any]] = [_load_key_file(path) for path in key_file or []]
    failures: list[dict[str, Any]] = []
    for spec in vault or []:
        try:
            keys.append(_load_vault(spec))
        except (ProbeError, KeyError, OSError, json.JSONDecodeError) as error:
            failures.append({"credential": spec, "errors": {"vault": str(error)}})
    for spec in heroku or []:
        try:
            keys.append(_load_heroku(spec))
        except (ProbeError, OSError, json.JSONDecodeError) as error:
            failures.append({"credential": spec, "errors": {"heroku": str(error)}})
    if gcloud:
        keys.append({"_gcloud": True})
    if not keys and not failures:
        print(
            "nothing to probe: pass --key-file, --vault, --heroku and/or --gcloud",
            file=sys.stderr,
        )
        raise SystemExit(2)

    owner = _ownership_for_run(
        keys, tuple(owned_parent or ()), tuple(owned_project or ())
    )
    _print_ownership_basis(owner)
    results = [_probe_one(key, owner) for key in keys] + [
        {"grants": [], "project": "", **failure} for failure in failures
    ]
    _emit(results, as_json=as_json, markdown=markdown)


def _emit(results: list[dict[str, Any]], *, as_json: bool, markdown: bool) -> None:
    if as_json:
        print(json.dumps(results, indent=2, sort_keys=True))
    elif markdown:
        print(_markdown_rows(results))
    else:
        _print_report(results)


def _print_ownership_basis(owner: Ownership) -> None:
    """Show what third-party classification rests on, every run.

    Printed because this is the input most likely to be quietly wrong, and a
    wrong verdict here is invisible in the table itself.
    """
    rendered = (
        ", ".join(
            parent or "none (standalone legacy project)"
            for parent in sorted(owner.owned_parents)
        )
        or "NONE RESOLVED -- every project will report 'unknown'"
    )
    print(f"\n# OL-owned means project parent in [{rendered}]", file=sys.stderr)
    print(
        "# Judged by project PARENT, not by `gcloud projects list` -- that call\n"
        "# includes third-party projects OL merely holds a grant into, which is\n"
        "# exactly the population this tool exists to find. Pin exceptions with\n"
        "# --owned-parent <folder/ID> or --owned-project <id>.\n",
        file=sys.stderr,
    )


@app.command(name="probe-all")
def probe_all(
    *,
    as_json: Annotated[
        bool, cyclopts.Parameter(name=["--json"], help="Emit JSON instead of text.")
    ] = False,
    markdown: Annotated[
        bool,
        cyclopts.Parameter(help="Emit the register's Findings table rows."),
    ] = False,
    skip_heroku: Annotated[
        bool,
        cyclopts.Parameter(help="Skip the Heroku-sourced credential."),
    ] = False,
    owned_parent: Annotated[
        list[str] | None,
        cyclopts.Parameter(
            help="Extra parent(s) to treat as OL's, e.g. folder/551004127831."
        ),
    ] = None,
    owned_project: Annotated[
        list[str] | None,
        cyclopts.Parameter(help="Project id(s) to force-classify as OL-owned."),
    ] = None,
) -> None:
    """Probe every known credential in the estate, in priority order.

    One caveat this cannot solve for you: `ocw-studio-production@` and
    `ocw-studio-rc@` share a single Vault path, and which one you get depends
    entirely on which Vault cluster VAULT_ADDR points at. Run this twice, once
    per cluster, or you will probe the same credential twice and read it as
    agreement. The header below prints the cluster actually used, and results
    are labelled by the `client_email` that answered rather than by the name
    the manifest guessed.
    """
    vault_addr = os.environ.get("VAULT_ADDR", "(VAULT_ADDR unset)")
    print(f"# Vault: {vault_addr}", file=sys.stderr)
    print(f"# {len(ESTATE)} credentials queued\n", file=sys.stderr)

    loaded: list[tuple[str, dict[str, Any]]] = []
    results: list[dict[str, Any]] = []
    for index, entry in enumerate(ESTATE, start=1):
        label = entry["label"]
        if "heroku" in entry and skip_heroku:
            print(f"[{index}/{len(ESTATE)}] SKIPPED {label}", file=sys.stderr)
            continue
        print(f"[{index}/{len(ESTATE)}] {label}", file=sys.stderr)
        try:
            key = (
                _load_heroku(entry["heroku"])
                if "heroku" in entry
                else _load_vault(entry["vault"])
            )
        except (ProbeError, KeyError, OSError, json.JSONDecodeError) as error:
            # A credential that cannot be loaded is reported, never skipped
            # silently -- a missing row here reads as "no grants" downstream.
            results.append(
                {
                    "credential": label,
                    "project": "",
                    "grants": [],
                    "errors": {"load": str(error)},
                }
            )
            print(f"      load failed: {error}", file=sys.stderr)
            continue
        loaded.append((label, key))

    # Ownership is built from every credential in the run, so a legacy-estate
    # credential and a mitol01 one do not each judge the other as third party.
    owner = _ownership_for_run(
        [key for _, key in loaded],
        tuple(owned_parent or ()),
        tuple(owned_project or ()),
    )
    _print_ownership_basis(owner)

    for label, key in loaded:
        result = _probe_one(key, owner)
        result["source_label"] = label
        results.append(result)
        print(
            f"      {result['credential']}: {len(result['grants'])} grant(s)",
            file=sys.stderr,
        )

    _warn_on_duplicate_identities(results)
    _emit(results, as_json=as_json, markdown=markdown)


def _warn_on_duplicate_identities(results: list[dict[str, Any]]) -> None:
    """Flag two manifest entries that resolved to the same service account.

    This is not cosmetic. If two sources yield one identity, some credential in
    the manifest was never probed at all, and its grants are missing from the
    output while every row present looks healthy. Observed for real: both
    `secret-data/pipelines/edx/org/gcp-oauth-client` and
    `secret-data/pipelines/google-service-account` returned
    `ol-data-platform-production@`, so `ol-data-platform-qa@` -- the credential
    holding the edx.org BigQuery grants -- went unprobed and the duplicated rows
    read as corroboration.
    """
    seen: dict[str, list[str]] = {}
    for result in results:
        identity = result.get("credential", "")
        if result.get("grants") or not result.get("errors"):
            seen.setdefault(identity, []).append(result.get("source_label", identity))
    for identity, labels in seen.items():
        if len(labels) > 1:
            print(
                f"\n# WARNING: {len(labels)} sources resolved to {identity}:",
                file=sys.stderr,
            )
            for label in labels:
                print(f"#   - {label}", file=sys.stderr)
            print(
                "# Its rows are duplicated below, and whichever credential the\n"
                "# other source was meant to reach was NOT probed. Do not read\n"
                "# the repeated rows as agreement.",
                file=sys.stderr,
            )


@app.command
def scopes() -> None:
    """Explain which scope each probe needs, and what an error from it means."""
    print(__doc__)
    print("Scopes requested (all read-only):")
    for scope in SCOPES:
        print(f"  {scope}")
    print(
        "\nA 403 from a probe usually means the credential holds nothing in that\n"
        "product, not that the tool is misconfigured. A 401 means the token\n"
        "exchange succeeded but the scope was refused -- check org policy."
    )


if __name__ == "__main__":
    app()
