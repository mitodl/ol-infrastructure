# The deployed settings (hindsight_settings in
# src/ol_infrastructure/applications/hindsight/__main__.py), pointed at the
# harness's services. Keep the two in step.
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_LOG_FORMAT=json
HINDSIGHT_API_WORKER_ID=harness-worker-0
PYTHONPATH=/opt/ol_ext
# The database URLs are in compose.yaml, where they can carry a
# detect-secrets allowlist comment.

HINDSIGHT_API_LLM_PROVIDER=none
HINDSIGHT_API_RETAIN_EXTRACTION_MODE=chunks
HINDSIGHT_API_ENABLE_OBSERVATIONS=false
HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=false
HINDSIGHT_API_LLM_TRACE_ENABLED=false
HINDSIGHT_API_STORE_DOCUMENT_TEXT=false
HINDSIGHT_API_VECTOR_INDEX_MIN_ROWS=10000
HINDSIGHT_API_MCP_ENABLED=false
HINDSIGHT_API_ENABLE_FILE_UPLOAD_API=false
HINDSIGHT_API_EMBEDDINGS_PROVIDER=tei
HINDSIGHT_API_EMBEDDINGS_TEI_URL=http://127.0.0.1:8090
HINDSIGHT_API_RERANKER_PROVIDER=rrf

HINDSIGHT_API_EXTENSION_PASSTHROUGH_HEADERS=x-ol-learner
HINDSIGHT_API_TENANT_EXTENSION=ol_memory_ext:KeycloakTenantExtension
HINDSIGHT_API_TENANT_ISSUER=http://127.0.0.1:8098/realms/ol-memory-harness
HINDSIGHT_API_TENANT_JWKS_URL=http://127.0.0.1:8098/realms/ol-memory-harness/protocol/openid-connect/certs
HINDSIGHT_API_TENANT_AUDIENCE=ol-memory-client
HINDSIGHT_API_TENANT_CLIENTS=learn-ai=learn-ai,mit-learn=mit-learn,catalog-indexer=catalog-indexer
HINDSIGHT_API_TENANT_ADMIN_CLIENTS=ol-memory-admin-client
HINDSIGHT_API_TENANT_GENERAL_SCOPE=ol-memory-general
HINDSIGHT_API_OPERATION_VALIDATOR_EXTENSION=ol_memory_ext:LearnerBankValidator
HINDSIGHT_API_MEMORY_DEFENSE_EXTENSION=ol_memory_ext:OLMemoryDefense
