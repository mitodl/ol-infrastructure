# Per-developer kustomize overlay for mit-learn-nextjs (gitignored once copied to
# kustomization.yaml in this directory). Whenever that file exists, Tilt builds
# this overlay instead of ../base, so any field of any tracked manifest can be
# changed without editing tracked files: a memory limit, a probe timeout,
# replicas, an image tag. See "Local Configuration Overrides" in
# local-dev/README.md.
#
# Env vars are simpler through app-env.local.yaml next to this file; use this
# overlay for everything else.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - ../base
patches:
  # A strategic merge patch: only the fields listed here change. The
  # namespace is required because the tracked Deployments set one, and a patch
  # without it matches nothing. Containers are matched by name.
  - patch: |-
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: mitlearn-nextjs
        namespace: mit-learn
      spec:
        template:
          spec:
            containers:
              - name: nextjs
                resources:
                  limits:
                    memory: 4Gi
