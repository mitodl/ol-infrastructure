# Per-developer overrides for odl-video-service (gitignored when copied).
#
# Copy to app-env.local.yaml and add entries under data: — because this
# ConfigMap is referenced LAST in every envFrom list in deployment.yaml, its
# keys override both the tracked app-env ConfigMap AND the tracked Secret
# (secret values are fine here: the file never leaves your machine). Pods
# roll automatically when you edit it. See "Local Configuration Overrides"
# in local-dev/README.md.
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: odlvideo-env-local
  namespace: odl-video-service
data:
  # VIDEO_S3_BUCKET: "my-test-bucket"
  #
  # The tracked config sets ENFORCE_MANDATORY_SETTINGS=False, so OVS starts
  # without these third-party credentials, but the features behind them
  # (transcoding, CloudFront playback, Dropbox import, YouTube upload,
  # Mailgun email) fail when used. Fill them in from your own accounts / the odl-video-service
  # compose .env to use those features:
  # AWS_ACCOUNT_ID: ""
  # AWS_ROLE_NAME: ""
  # CLOUDFRONT_KEY_ID: ""
  # CLOUDFRONT_PRIVATE_KEY: ""
  # The Dropbox app behind DROPBOX_KEY must list video.odl.mit.test under
  # "Chooser / Saver / Embedder domains" in the Dropbox App Console, or the
  # "Add Videos from Dropbox" chooser fails with "App is misconfigured".
  # DROPBOX_KEY: ""
  # DROPBOX_SECRET: ""
  # DROPBOX_REFRESH_TOKEN: ""
  # LECTURE_CAPTURE_USER: ""
  # MAILGUN_KEY: ""
  # MAILGUN_URL: ""
  # VIDEO_CLOUDFRONT_DIST: ""
  # VIDEO_CDN_DISTRIBUTION_ID: ""
  # YT_ACCESS_TOKEN: ""
  # YT_REFRESH_TOKEN: ""
  # YT_CLIENT_ID: ""
  # YT_CLIENT_SECRET: ""
  # If your local database already has rows written with a different
  # FIELD_ENCRYPTION_KEY, set it here too; this file wins over secrets.yaml.
  # FIELD_ENCRYPTION_KEY: ""
