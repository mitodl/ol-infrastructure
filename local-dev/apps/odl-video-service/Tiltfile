# odl-video-service Tiltfile
# When the sibling odl-video-service repo is not checked out, Tilt uses the
# prebuilt DockerHub image (mitodl/odl-video-service-app:latest) without
# attempting a local build.

load("../../tiltlib.star", "k8s_yaml_local")

workspace_root = os.environ.get("MITOL_WORKSPACE_ROOT", config.main_dir + "/..")
APP_DIR = os.path.join(workspace_root, "odl-video-service")
IMAGE = 'mitodl/odl-video-service-app'
NAMESPACE = 'odl-video-service'
DEPLOY_NAME = 'odlvideo-webapp'

if os.path.exists(os.path.join(APP_DIR, '.git')):
    # `local-dev` (production + dev deps + watchfiles, so granian can --reload;
    # see deployment.yaml) exists from odl-video-service#1593 on. Older
    # checkouts only have `production`. Never build untargeted: the last stage,
    # `development`, has no source tree and no manage.py. read_file() also
    # makes Tilt re-evaluate this when the Dockerfile changes.
    has_local_dev = 'AS local-dev' in str(read_file(APP_DIR + '/Dockerfile'))
    docker_build(
        IMAGE,
        context=APP_DIR,
        dockerfile=APP_DIR + '/Dockerfile',
        target='local-dev' if has_local_dev else 'production',
        # Sync the whole repo (Django apps are top-level dirs: ui, cloudsync,
        # techtv2ovs, ...); granian's --reload-ignore-dirs filters the churn.
        # Only with the local-dev target: without --reload a sync makes Tilt
        # skip the rebuild and edits never land.
        live_update=[
            sync(APP_DIR, '/src'),
            run(
                'cd /src && uv sync --frozen',
                trigger=[APP_DIR + '/pyproject.toml', APP_DIR + '/uv.lock'],
            ),
        ] if has_local_dev else [],
    )

k8s_yaml_local([
    'configmaps/app-env.yaml',
    'secrets.yaml',
    'deployment.yaml',
    'apisix-routes.yaml',
], local_overrides='configmaps/app-env.local.yaml')

k8s_resource(
    DEPLOY_NAME,
    # granian listens on 8089 (deployment.yaml); keep the host side on 8088 so
    # it doesn't collide with the docker-compose nginx on 8089.
    port_forwards=['8088:8089'],
    labels=['odl-video-service'],
    resource_deps=['local-infra-apps'],
)

k8s_resource('odlvideo-celery', labels=['odl-video-service'], resource_deps=['local-infra-apps'])
k8s_resource('odlvideo-celery-beat', labels=['odl-video-service'], resource_deps=['local-infra-apps'])
