# Open edX (lehrer) composed into the ol-infrastructure local-dev cluster.
#
# The point of this file is that there is exactly one Open edX local-dev stack
# and one k3d cluster. lehrer owns the build definitions and manifests; this
# repo owns deployment topology, and passes that topology to lehrer's setup()
# rather than forking its manifests. See
# pf-decision-lehrer-owns-build-definitions-ol-infras.
#
# What "composed" means concretely, versus `lehrer dev start`:
#   - Valkey and OpenSearch come from the shared local-infra namespace
#     (manage_infra=False), not a second copy in the openedx namespace.
#   - MariaDB and MongoDB are still lehrer's, since this cluster has neither.
#   - Ingress is APISIX on the shared wildcard cert, not port-forwards.
#   - Config deltas are layered via configmaps/, not a forked ConfigMap.
#
# Prerequisites:
#   - lehrer checked out at $MITOL_WORKSPACE_ROOT/lehrer (defaults to a sibling
#     of this repo)
#   - dagger on PATH: every lehrer image build, including the two legacy MFE
#     builds below, shells out to `dagger call`
#   - the local-infra-core and local-infra-apps Pulumi stacks applied, which is
#     what creates the openedx namespace and replicates local-dev-tls into it

load("../../tiltlib.star", "k8s_yaml_local", "current_root_domain")

# The app dir holding Dockerfile.mfe and nginx-mfe.conf.template, which every
# legacy MFE image below is built from.
_openedx_app_dir = config.main_dir + "/local-dev/apps/openedx"


def legacy_mfe(name, repo, public_path, env, lehrer_dir, slot_config):
    """Build frontend-app-<name> with lehrer's dagger module and serve it in-cluster.

    public_path is the URL prefix the bundle is built for and served under,
    without slashes ("learn"); env is the list of KEY=VALUE build variables
    apart from PUBLIC_PATH and APP_ID. PUBLIC_PATH is derived from
    public_path here so the bundle's asset prefix, nginx's MFE_PATH and the
    readiness probe cannot disagree; APP_ID is name, which matches
    production's application ids ("learning", "authoring"). Produces the
    openedx-mfe-<name> image and the mfe-<name> Deployment and Service; the
    APISIX route that reaches it lives in apisix-routes.yaml.
    """
    ctx = "/tmp/ol-local-dev-mfe-" + name
    image = "openedx-mfe-" + name
    # PUBLIC_PATH drives both the asset tags in index.html and the webpack
    # runtime's chunk loader (r.p); it has to agree with the APISIX route path
    # and with MFE_PATH, where Dockerfile.mfe puts the dist.
    env = env + ["PUBLIC_PATH=/" + public_path + "/"]
    # lehrer's slot config picks each MFE's header and footer overrides by
    # APP_ID; without it the authoring MFE gets the LMS footer, not Studio's.
    env = env + ["APP_ID=" + name]

    # build-legacy-configured, not build-legacy: it resolves this deployment's
    # extra_slot_files, per-release variants and extra_npm_bundles from
    # lehrer's mfe_slot_config/legacy/build_config.yaml, so the local build
    # carries the same slot overrides as production instead of a bare upstream
    # bundle. build-legacy would need all of that restated here.
    #
    # dir=lehrer_dir: `dagger call` resolves its module from the working
    # directory, and dagger.json lives in lehrer, not here. Without it every
    # build fails with `unknown command "mfe"`.
    custom_build(
        ref=image,
        command=(
            "set -e && " +
            "rm -rf " + ctx + " && " +
            "mkdir -p " + ctx + " && " +
            "dagger --progress=plain call mfe build-legacy-configured" +
            " --slot-config " + slot_config +
            " --release-name master" +
            # build-legacy-configured defaults node_version to 20 (lehrer
            # src/lehrer/core/mfe.py) and does not derive it from
            # --release-name. The master release is Node 24
            # (OpenEdxSupportedRelease.master, src/bridge/settings/openedx/
            # types.py), which is also what these MFEs' .nvmrc files ask for,
            # so pass it explicitly or the local build runs on a runtime
            # production never uses.
            " --node-version 24" +
            " --mfe-name " + name +
            " --mfe-repo " + repo +
            " --mfe-branch master" +
            " --deployment-name mitxonline" +
            # Comma-separated because that is how dagger takes a `strings`
            # argument; no value may contain a comma.
            " --env-vars '" + ",".join(env) + "'" +
            " export --path " + ctx + "/dist && " +
            "cp " + _openedx_app_dir + "/nginx-mfe.conf.template " + ctx + "/ && " +
            "docker build -t $EXPECTED_REF" +
            " --build-arg MFE_PATH=" + public_path +
            " -f " + _openedx_app_dir + "/Dockerfile.mfe " + ctx
        ),
        # The slot config and this app dir, not the upstream repo: the MFE
        # source is cloned inside dagger, so Tilt has nothing local to watch
        # for it. A new upstream commit needs a manual trigger.
        deps=[slot_config, _openedx_app_dir + "/Dockerfile.mfe",
              _openedx_app_dir + "/nginx-mfe.conf.template"],
        dir=lehrer_dir,
    )

    deployment = "mfe-" + name
    k8s_yaml(blob(
        "apiVersion: apps/v1\n" +
        "kind: Deployment\n" +
        "metadata:\n" +
        "  name: " + deployment + "\n" +
        "  namespace: openedx\n" +
        "spec:\n" +
        "  replicas: 1\n" +
        "  selector:\n" +
        "    matchLabels:\n" +
        "      app: " + deployment + "\n" +
        "  template:\n" +
        "    metadata:\n" +
        "      labels:\n" +
        "        app: " + deployment + "\n" +
        "    spec:\n" +
        "      containers:\n" +
        "      - name: mfe\n" +
        "        image: " + image + "\n" +
        "        ports:\n" +
        "        - containerPort: 80\n" +
        "        readinessProbe:\n" +
        # The prefix, not /: nginx-mfe.conf.template deliberately 404s the
        # root, so probing / would never pass.
        "          httpGet:\n" +
        "            path: /" + public_path + "/\n" +
        "            port: 80\n" +
        "          initialDelaySeconds: 5\n" +
        "          periodSeconds: 10\n" +
        "        resources:\n" +
        "          requests:\n" +
        "            memory: 64Mi\n" +
        "            cpu: 50m\n" +
        "          limits:\n" +
        "            memory: 128Mi\n" +
        "            cpu: 200m\n" +
        "---\n" +
        "apiVersion: v1\n" +
        "kind: Service\n" +
        "metadata:\n" +
        "  name: " + deployment + "\n" +
        "  namespace: openedx\n" +
        "spec:\n" +
        "  selector:\n" +
        "    app: " + deployment + "\n" +
        "  ports:\n" +
        "  - name: http\n" +
        "    port: 80\n" +
        "    targetPort: 80\n" +
        "  type: ClusterIP\n"
    ))
    k8s_resource(deployment, labels=["mfe"], resource_deps=["local-infra-apps"])


workspace_root = os.environ.get("MITOL_WORKSPACE_ROOT", config.main_dir + "/..")
lehrer_dir = os.path.join(workspace_root, "lehrer")

if not os.path.exists(os.path.join(lehrer_dir, ".git")):
    print("WARNING: lehrer repo not found at " + lehrer_dir + " — skipping openedx deployment.")
    print("  Set MITOL_WORKSPACE_ROOT to the directory containing the lehrer repo.")
else:
    # load_dynamic, not load: Starlark's load() takes a string literal only, so
    # a path derived from MITOL_WORKSPACE_ROOT cannot go through it.
    setup = load_dynamic(os.path.join(lehrer_dir, "local-dev/lehrer-core.star"))["setup"]

    local_dev = os.path.join(lehrer_dir, "local-dev")

    # Applied through k8s_yaml_local, not k8s_yaml, for the 'mit.test' ->
    # LOCAL_DEV_ROOT_DOMAIN substitution. Layered last in envFrom by lehrer's
    # manifests.
    #
    # k8s_yaml_local's own fingerprint does NOT reach these pods: it stamps
    # Deployments passed in the same call (tiltlib.star _stamp_deployments) and
    # lehrer applies its Deployments separately inside setup(). The rollout
    # comes from config_override_paths below, which folds these two files into
    # the checksum lehrer stamps on its platform pod templates.
    k8s_yaml_local([
        "configmaps/lms-config.yaml",
        "configmaps/cms-config.yaml",
    ])

    setup({
        "deploy_config":   os.path.join(lehrer_dir, "deployments/mit-ol"),
        "registry":        "localhost:5001",
        "registry_k8s":    "k3d-registry.localhost:5000",
        # Shared with every other app in this cluster. The chart names the
        # Service "opensearch-cluster-master", which is also what mit-learn's
        # OPENSEARCH_URL points at.
        "opensearch_host": "opensearch-cluster-master.local-infra.svc.cluster.local",
        "namespace":       "openedx",
        # This cluster already runs Valkey and OpenSearch; it runs neither
        # MariaDB nor MongoDB, so those two stay lehrer's.
        "manage_infra":    False,
        "mysql_managed":   True,
        "mongo_managed":   True,
        # Created from lehrer's local-dev/secret-defaults.yaml, the same file
        # `lehrer dev setup` reads. Nothing here restates the key list.
        "manage_secrets":  True,
        "ingress":         "apisix",
        "mfe_hot_reload":  False,
        "notes_repo":      "https://github.com/openedx/edx-notes-api",
        # Empty: lehrer's own operator values are correct here, and
        # helm_values() falls back to them.
        "helm_override_dir": "",
        "local_dev_dir":   local_dev,
        # True: lehrer applies its full lms-config/cms-config and this repo
        # supplies only deltas via the *-config-overrides ConfigMaps above.
        # Setting False would mean forking the whole ConfigMap and drifting.
        "apply_platform_configmaps": True,
        # Folded into the pod-template checksum lehrer stamps on the platform
        # Deployments, so editing an override actually rolls LMS/CMS/workers.
        "config_override_paths": [
            config.main_dir + "/local-dev/apps/openedx/configmaps/lms-config.yaml",
            config.main_dir + "/local-dev/apps/openedx/configmaps/cms-config.yaml",
        ],
        # config_override_paths alone hashes those two files' raw, pre-render
        # content, but k8s_yaml_local substitutes current_root_domain() for
        # 'mit.test' in them before applying — so a domain override changes the
        # ConfigMaps without changing the checksum lehrer stamps on the pod
        # template, and LMS/CMS/workers never roll onto the new URLs. Folding
        # the same value in here (lehrer#238) fixes that.
        "config_override_extra_hash_input": [current_root_domain()],
        "release_name":    "master",
        "deploy_name":     "mitxonline",
        "settings_ns":     "mitol",
    })

    # manage_infra=False means lehrer's own infra_deps never includes "redis"
    # or "opensearch" (lehrer-core.star only adds those when it owns them);
    # nothing otherwise stops edxapp-migrate/notes-migrate — both
    # backoffLimit: 0 Jobs — from racing this cluster's shared OpenSearch on a
    # fresh `tilt up`. Every other resource here (LMS/CMS/workers/notes)
    # already depends on one of these two Jobs, so gating just these two on
    # "local-infra-apps" — the same resource every sibling app Tiltfile in
    # this repo waits on — orders the whole stack behind it. Tilt merges
    # resource_deps across repeated k8s_resource() calls rather than
    # replacing them, so this adds to lehrer's own resource_deps for these
    # Jobs instead of dropping them.
    k8s_resource("edxapp-migrate", resource_deps=["local-infra-apps"])
    k8s_resource("notes-migrate", resource_deps=["local-infra-apps"])

    # -----------------------------------------------------------------------
    # Legacy MFEs: learning (frontend-app-learning) and course authoring
    # (frontend-app-authoring)
    #
    # lehrer's build_manifest.yaml ships only the frontend-base *site project*
    # (admin-console / gradebook / instructor-dashboard). Neither of these has
    # landed on frontend-base -- there is no @openedx/frontend-app-learning or
    # @openedx/frontend-app-authoring on npm -- so they cannot join that site
    # project, and version_matrix.py builds both the legacy way for every real
    # deployment (no branch_override, unlike admin-console and gradebook which
    # are pinned to "legacy-mfe"). Without the learning MFE nothing serves
    # /learn and every "go to course" link 404s. Without the authoring MFE
    # Studio has no pages at all on the master release: its home view is a
    # redirect to COURSE_AUTHORING_MICROFRONTEND_URL and the shared header
    # template resolves the same URL on every page, 500.html included, so each
    # of them raises ImproperlyConfigured while the setting is unset.
    #
    # Built here rather than in lehrer only because lehrer's local-dev does not
    # expose a legacy-MFE build; lehrer still owns the build *definition* --
    # legacy_mfe() calls its dagger module and its build_config.yaml, and adds
    # no new build logic of its own. If lehrer ever grows a legacy_mfes option
    # to setup(), these two calls collapse into passing it a list.
    # -----------------------------------------------------------------------
    _rd = current_root_domain()
    _mfe_slot_config = os.path.join(lehrer_dir, "deployments/mit-ol/mfe_slot_config/legacy")

    # Mirrors the production build env in
    # src/ol_concourse/pipelines/open_edx/mfe/pipeline.py (mfe_params), with
    # local-dev hostnames; production sends the same set to every MFE. Three
    # entries differ per MFE: BASE_URL is added at each legacy_mfe() call
    # below, and PUBLIC_PATH and APP_ID come from legacy_mfe() itself. The
    # cookie names are not cosmetic: the MFE reads the LMS's user-info cookie
    # to decide whether it has a session, and its JWT cookie to authenticate
    # every API call, so a mismatch with
    # EDXMKTG_USER_INFO_COOKIE_NAME / LANGUAGE_COOKIE_NAME / JWT_AUTH's
    # JWT_AUTH_COOKIE_HEADER_PAYLOAD presents as a permanently logged-out MFE
    # or as a hard error page. Values read off the running LMS.
    _mfe_env = [
        "LMS_BASE_URL=https://lms." + _rd,
        "STUDIO_BASE_URL=https://studio." + _rd,
        "LOGIN_URL=https://lms." + _rd + "/login",
        "LOGOUT_URL=https://lms." + _rd + "/logout",
        "REFRESH_ACCESS_TOKEN_ENDPOINT=https://lms." + _rd + "/login_refresh",
        "LEARNING_BASE_URL=https://lms." + _rd + "/learn",
        "DISCUSSIONS_MFE_BASE_URL=https://lms." + _rd + "/discussions",
        "MARKETING_SITE_BASE_URL=https://mitxonline." + _rd,
        "USER_INFO_COOKIE_NAME=edx-user-info",
        # The JWT cookie the LMS actually sets (its JWT_AUTH
        # JWT_AUTH_COOKIE_HEADER_PAYLOAD). frontend-platform defaults this to
        # the empty string, and an empty name is not inert: the token service
        # reads Cookies.get("") -> undefined, POSTs login_refresh, gets a 200,
        # re-reads Cookies.get("") -> still undefined, and throws. The throw
        # goes to logError -> NewRelicLoggingService, which is silent in a
        # production build, so the only symptom is the generic "An unexpected
        # error occurred" page with a *successful* login_refresh in the network
        # tab and no course API calls after it. Production sets this too
        # (ol_concourse/pipelines/open_edx/mfe/pipeline.py), prefixed per
        # environment; this deployment's cookies carry no prefix.
        "ACCESS_TOKEN_COOKIE_NAME=edx-jwt-cookie-header-payload",  # pragma: allowlist secret
        # A cookie *name*, not a value; detect-secrets reads the hyphenated
        # string as base64 entropy.
        "LANGUAGE_PREFERENCE_COOKIE_NAME=openedx-language-preference",  # pragma: allowlist secret
        "SESSION_COOKIE_DOMAIN=" + _rd,
        # Where the MFE primes its CSRF token before any non-GET. Unset,
        # frontend-platform defaults it to the empty string and the prime
        # request goes to the LMS root, which answers HTML with no token --
        # so every write (mark-complete, save-course-goal, sequence progress)
        # fails while the initial all-GET render still looks fine. Same path
        # production uses. It is deliberately absent from
        # MITX_REDIRECT_ALLOW_RE_LIST, here and in production: that middleware
        # only redirects anonymous users, and by the time the MFE primes CSRF
        # the session exists.
        # An API path, not a token; detect-secrets reads the slashed
        # string as base64 entropy because the name contains TOKEN.
        "CSRF_TOKEN_API_PATH=/csrf/api/v1/token",  # pragma: allowlist secret
        "SITE_NAME=MIT Open Learning",
        # Below here: required by the header/footer components via
        # frontend-platform's ensureConfig, which only logs -- these do not
        # break the app, they just fill the console with "App configuration
        # error: X is required by Y" and render a degraded footer.
        #
        # All of them come from mfe_params() in
        # ol_concourse/pipelines/open_edx/mfe/pipeline.py in production except
        # SUPPORT_EMAIL and ENABLE_ACCESSIBILITY_PAGE, which have no entry
        # there and are set here only to quiet those two warnings locally.
        # Treat those two as local-only, not as a record of what production
        # sends.
        "SUPPORT_EMAIL=mitlearn-support@mit.edu",  # local-only, not in mfe_params()
        "SUPPORT_URL=https://mitxonline." + _rd + "/support",
        "ENABLE_ACCESSIBILITY_PAGE=true",  # local-only, not in mfe_params()
        "ACCESSIBILITY_URL=https://accessibility.mit.edu/",
        "TERMS_OF_SERVICE_URL=https://mitxonline." + _rd + "/terms",
        "PRIVACY_POLICY_URL=https://mitxonline." + _rd + "/privacy",
        "LOGO_URL=https://lms." + _rd + "/static/mitxonline/images/logo.png",
        "LOGO_TRADEMARK_URL=https://lms." + _rd + "/static/mitxonline/images/logo.png",
        "LOGO_WHITE_URL=https://lms." + _rd + "/static/mitxonline/images/logo.png",
        "FAVICON_URL=https://lms." + _rd + "/static/mitxonline/images/favicon.ico",
        # Gates the mitxonline-specific plugin slots the bundle checks for by
        # name. The dagger build already takes --deployment-name; this is the
        # value the *browser* sees, which is a separate input.
        "DEPLOYMENT_NAME=mitxonline",
    ]

    legacy_mfe(
        "learning", "https://github.com/openedx/frontend-app-learning", "learn",
        _mfe_env + ["BASE_URL=https://lms." + _rd + "/learn"],
        lehrer_dir, _mfe_slot_config,
    )
    # On the Studio host, as in production (mfe_params builds this one MFE's
    # BASE_URL from studio_domain). configmaps/cms-config.yaml points the CMS's
    # COURSE_AUTHORING_MICROFRONTEND_URL at the same place.
    legacy_mfe(
        "authoring", "https://github.com/openedx/frontend-app-authoring", "authoring",
        _mfe_env + ["BASE_URL=https://studio." + _rd + "/authoring"],
        lehrer_dir, _mfe_slot_config,
    )

    k8s_yaml_local(["apisix-routes.yaml"])
