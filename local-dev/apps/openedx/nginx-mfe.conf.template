# Rendered by the nginx image's entrypoint with MFE_PATH substituted (see
# Dockerfile.mfe); nginx's own $uri and $scheme pass through untouched.
server {
    listen 80;
    index index.html;

    # Emit a relative Location header. TLS terminates at APISIX, so $scheme in
    # here is http; with the default `absolute_redirect on` the redirect below
    # would rewrite the browser's https:// URL to http:// and downgrade the
    # scheme. Relative leaves the browser on whatever it came in on.
    absolute_redirect off;

    # The MFE is built with PUBLIC_PATH=/${MFE_PATH}/, so its own HTML asks for
    # /${MFE_PATH}/runtime.<hash>.js, /${MFE_PATH}/app.<hash>.css and so on,
    # and its webpack runtime loads lazy chunks from the same prefix. It
    # therefore cannot use lehrer's shared nginx-mfe.conf, which serves the
    # dist at /.
    #
    # The dist is COPYed to /usr/share/nginx/html/${MFE_PATH}/ rather than
    # aliased from the root: `alias` inside a prefix location plus try_files
    # has surprising interactions with the fallback path, whereas a real
    # subdirectory lets `root` resolve /${MFE_PATH}/* the obvious way.
    root /usr/share/nginx/html;

    # SPA routing. /${MFE_PATH}/course/<key>/home is a React Router path with
    # no file behind it, so anything that is not a real file falls through to
    # the MFE's index.html. The fallback is /${MFE_PATH}/index.html, not
    # /index.html: the document that comes back has to be the one whose asset
    # tags are already prefixed.
    location /${MFE_PATH}/ {
        try_files $uri $uri/ /${MFE_PATH}/index.html;
    }

    # Bare /${MFE_PATH}, no trailing slash. The platform's *_MICROFRONTEND_URL
    # settings carry no trailing slash, so the LMS and Studio can emit exactly
    # this path; the APISIX route lists it for the same reason. `location
    # /${MFE_PATH}/` does not match it and the catch-all below would 404 it,
    # so redirect into the prefix that does.
    location = /${MFE_PATH} {
        return 301 /${MFE_PATH}/;
    }

    # Content-hashed by webpack, so safe to cache hard: a rebuild that changes
    # the bytes changes the URL. The hash segment is what makes that true, so
    # match on it rather than on the extension alone -- `app.<hash>.js` and
    # `<n>.<hash>.chunk.js` both qualify. Scoped to the prefix so it cannot
    # start claiming paths this server does not own.
    #
    # Quoted: nginx reads an unquoted `{` as the start of a block, so the
    # `{8,}` quantifier fails the config parse with "unknown directive".
    location ~* "^/${MFE_PATH}/.*\.[0-9a-f]{8,}\.(?:[^/]*\.)?(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map)$" {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The same file types without a hash: assets copied verbatim out of the
    # MFE's public/, loaded by their stable names (frontend-app-learning's
    # courseware iframe pulls in /learn/static/LmsHtmlFragment.css this way).
    # Their URL does not change when a local rebuild changes the
    # bytes, so `immutable` would pin a stale copy in the browser for a year
    # -- exactly the edit-reload loop this local-dev setup exists for.
    # no-cache still stores the response, it just forces revalidation, so the
    # 304s stay cheap.
    #
    # Regex locations are matched in file order, so this has to sit after the
    # hashed rule above or it would swallow those too.
    location ~* "^/${MFE_PATH}/.*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map)$" {
        add_header Cache-Control "public, no-cache";
    }

    # Anything outside the prefix is a routing mistake upstream rather than a
    # client error worth a page: this Service is only ever reached through its
    # APISIX /${MFE_PATH}/* route. 404 plainly instead of falling back to the
    # SPA, which would make a misrouted path look like a broken MFE.
    location / {
        return 404;
    }
}
