# Per-developer kustomize overlay for learn-ai (gitignored once copied to
# kustomization.yaml in this directory). Whenever that file exists, Tilt builds
# this overlay instead of ../base, so any field of any tracked manifest can be
# changed without editing tracked files: a memory limit, a probe timeout,
# replicas, an image tag. See "Local Configuration Overrides" in
# local-dev/README.md.
#
# Copy app-env.local.yaml.example beside this file to app-env.local.yaml as
# well: it is listed under resources below, and kustomize fails if it is
# missing. Env vars and secret values go there; patches cover everything else.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - ../base
  # The env-override ConfigMap: referenced last in every container's envFrom,
  # so its keys win over the tracked ConfigMap and Secret.
  - app-env.local.yaml
# Uncomment to change anything else in a tracked manifest. This is a strategic
# merge patch: only the fields listed change. The namespace is required because
# the tracked Deployments set one, and a patch without it matches nothing.
# Containers are matched by name.
# patches:
#   - patch: |-
#       apiVersion: apps/v1
#       kind: Deployment
#       metadata:
#         name: learnai-webapp
#         namespace: learn-ai
#       spec:
#         template:
#           spec:
#             containers:
#               - name: app
#                 resources:
#                   limits:
#                     memory: 4Gi
