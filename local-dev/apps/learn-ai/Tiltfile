# learn-ai Tiltfile
# Builds the learn-ai Django/ASGI app and deploys it to the learn-ai namespace.
# When the sibling learn-ai repo is not checked out, the published
# mitodl/learn-ai-app image runs (latest, or the prebuilt_tags pin).
# With a checkout it also serves the sandbox (frontend-demo); see sandbox.yaml.

load("../../tiltlib.star", "k8s_yaml_local", "current_root_domain", "pulumi_app_rows")

workspace_root = os.environ.get("MITOL_WORKSPACE_ROOT", config.main_dir + "/..")
APP_DIR = os.path.join(workspace_root, "learn-ai")
IMAGE = 'mitodl/learn-ai-app'
# Must equal the root Tiltfile's deploy_name for learn-ai, which seeds use as
# this resource's name and as the Deployment they exec into (the component names
# it learn-ai-app).
DEPLOY_NAME = 'learn-ai-app'
PROGRAM_DIR = os.path.join(config.main_dir, 'local-dev/apps/learn-ai/pulumi')
APPLY = os.path.join(config.main_dir, 'local-dev/scripts/pulumi-app-apply.sh')
root_domain = current_root_domain()
HAS_CHECKOUT = os.path.exists(os.path.join(APP_DIR, '.git'))

# Static export of frontend-demo, served by nginx. NEXT_PUBLIC_* values are
# inlined by `next build`, so they are build args. NODE_OPTIONS caps the main
# build process's heap (not Next's workers): BuildKit RUN steps have no limit.
SANDBOX_DOCKERFILE = """
FROM node:24.15@sha256:f22d6a1f082c02f292e86929b5b0442ac2e5eaf438a5dea9b1566601c3e05940 AS build
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 NODE_OPTIONS=--max-old-space-size=2048
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn/releases ./.yarn/releases
RUN corepack enable && yarn install --immutable
COPY . .
ARG NEXT_PUBLIC_MITOL_API_BASE_URL
ARG NEXT_PUBLIC_AI_CSRF_COOKIE_NAME
ARG NEXT_PUBLIC_AI_FEEDBACK_URL
ARG NEXT_PUBLIC_MIT_LEARN_AI_LOGIN_URL
ARG NEXT_PUBLIC_MIT_LEARN_API_BASE_URL
ARG NEXT_PUBLIC_MIT_LEARN_APP_BASE_URL
ARG NEXT_PUBLIC_MIT_SEARCH_ELASTIC_URL
ARG NEXT_PUBLIC_MIT_SEARCH_VECTOR_URL
ARG NEXT_PUBLIC_OPENEDX_API_BASE_URL
ARG NEXT_PUBLIC_OPENEDX_LOGIN_URL
RUN yarn build

FROM nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de
COPY --from=build /app/out /usr/share/nginx/html
"""

if HAS_CHECKOUT:
    docker_build(
        IMAGE,
        context=APP_DIR,
        dockerfile=APP_DIR + '/Dockerfile',
        # local-dev = development (dev deps, including granian[reload]) with a
        # mitodl-owned /src for the sync below and granian reload switched on.
        target='local-dev',
        # .claude/ holds agent worktrees; syncing one into the pod restarted it in a loop.
        # frontend-demo/ is the sandbox, built separately below; without this every
        # sandbox edit rebuilt this image and rolled the webapp and celery pods.
        ignore=['.claude/', 'frontend-demo/'],
        live_update=[
            # Dependency changes rebuild the image rather than running uv sync
            # in the pods: Celery doesn't reload, so running processes would
            # keep the old packages, and a restarted container loses the sync.
            fall_back_on([APP_DIR + '/pyproject.toml', APP_DIR + '/uv.lock']),
            sync(APP_DIR, '/src'),
        ],
    )

# ApisixTls is hand-written: the deployed program gets it from an
# OLCertManagerCert this program does not render. It references the
# local-dev-tls wildcard the core stack writes into this namespace.
k8s_yaml_local(['apisix-tls.yaml'])
k8s_resource(
    new_name='learnai-tls',
    objects=['learnai-tls:apisixtls'],
    labels=['learn-ai'],
    resource_deps=['local-infra-core'],
)

# The workloads and the gateway routes come from the deployed definition,
# rendered by local-dev/apps/learn-ai/pulumi (pulumi up as a custom deploy).
# The apply timeout this resource needs (its apply includes the migrate Job)
# is session-wide, so the root Tiltfile sets it.
prebuilt_tags = os.environ.get('LOCAL_DEV_PREBUILT_IMAGE_TAGS', '')
# Everything the render reads; .tiltignore keeps __pycache__ out of these.
PROGRAM_DEPS = [
    PROGRAM_DIR,
    APPLY,
    os.path.join(config.main_dir, 'local-dev/scripts/pulumi-clear-stale-lock.sh'),
    os.path.join(config.main_dir, 'local-dev/scripts/pulumi-pending-objects.py'),
    os.path.join(config.main_dir, 'src/ol_infrastructure/applications/learn_ai'),
    os.path.join(config.main_dir, 'src/ol_infrastructure/components/services'),
    os.path.join(config.main_dir, 'src/ol_infrastructure/lib'),
    os.path.join(config.main_dir, 'src/bridge/lib'),
    'secrets.yaml',
    'llm-stub',
]
k8s_custom_deploy(
    DEPLOY_NAME,
    apply_cmd=[APPLY, 'learn-ai', 'up'],
    delete_cmd=[APPLY, 'learn-ai', 'down'],
    # The pin and the root domain reach the program through the environment;
    # naming them here makes a change re-apply, which os.putenv alone would not.
    apply_env={'LOCAL_DEV_ROOT_DOMAIN': root_domain, 'LOCAL_DEV_PREBUILT_IMAGE_TAGS': prebuilt_tags},
    delete_env={'LOCAL_DEV_ROOT_DOMAIN': root_domain, 'LOCAL_DEV_PREBUILT_IMAGE_TAGS': prebuilt_tags},
    deps=PROGRAM_DEPS,
    # Without a checkout nothing registers the image, and naming it here would
    # fail the Tiltfile load; the program then runs the published image.
    image_deps=[IMAGE] if HAS_CHECKOUT else [],
)
k8s_resource(
    DEPLOY_NAME,
    labels=['learn-ai'],
    # local-infra-apps writes ol-mitlearn-oidc, which every rendered route reads.
    resource_deps=['local-infra-apps'],
    links=[link('https://ai.learn.' + root_domain + '/admin/', 'learn-ai Django admin')] + (
        [link('https://ai-sandbox.learn.' + root_domain, 'learn-ai sandbox')] if HAS_CHECKOUT else []
    ),
)

# The Celery worker, beat and the model stub get resources of their own; see
# "Celery resources" in local-dev/README.md.
pulumi_app_rows(
    'learn-ai',
    workers=['all'],
    beat=True,
    extra_rows={'learn-ai-llm-stub': {'ol.mit.edu/component': 'llm-stub'}},
    app_dir=APP_DIR if HAS_CHECKOUT else None,
    deps=PROGRAM_DEPS,
)

# No image is published for the sandbox, so it exists only with a checkout.
# Manual trigger: a save never costs a `next build`. Source, build-arg and
# sandbox-env.local.yaml changes all wait for a click on this resource; it
# still builds on `tilt up`, after the webapp so the two builds don't overlap.
if HAS_CHECKOUT:
    docker_build(
        'learnai-sandbox',
        context=os.path.join(APP_DIR, 'frontend-demo'),
        dockerfile_contents=SANDBOX_DOCKERFILE,
        build_args={
            'NEXT_PUBLIC_MITOL_API_BASE_URL': 'https://api.learn.' + root_domain + '/ai',
            'NEXT_PUBLIC_AI_CSRF_COOKIE_NAME': 'learn_ai_csrftoken',
            'NEXT_PUBLIC_AI_FEEDBACK_URL': 'https://api.learn.' + root_domain + '/ai/api/v0/chat_sessions/:threadId/messages/:checkpointPk/rate/',
            'NEXT_PUBLIC_MIT_LEARN_AI_LOGIN_URL': 'https://api.learn.' + root_domain + '/ai/http/login/',
            'NEXT_PUBLIC_MIT_LEARN_API_BASE_URL': 'https://api.learn.' + root_domain + '/learn/',
            'NEXT_PUBLIC_MIT_LEARN_APP_BASE_URL': 'https://learn.' + root_domain + '/',
            # Production search, as every deployed sandbox uses
            # (src/ol_concourse/pipelines/applications/learn_ai_frontend/values.py).
            'NEXT_PUBLIC_MIT_SEARCH_ELASTIC_URL': 'https://api.learn.mit.edu/api/v1/learning_resources_search/',
            'NEXT_PUBLIC_MIT_SEARCH_VECTOR_URL': 'https://api.learn.mit.edu/api/v0/vector_learning_resources_search/',
            # nginx proxies this to RC Open edX; see sandbox.yaml.
            'NEXT_PUBLIC_OPENEDX_API_BASE_URL': '/openedx_proxy/',
            'NEXT_PUBLIC_OPENEDX_LOGIN_URL': 'https://courses.rc.learn.mit.edu/auth/login/ol-oauth2/?auth_entry=login',
        },
        ignore=[
            'node_modules', '.next', 'out', 'coverage', 'tsconfig.tsbuildinfo',
            'next-env.d.ts', '.yarn/cache', '.yarn/install-state.gz',
        ],
    )

    # The sandbox has no deployed definition, so it is plain YAML outside the
    # Pulumi program. The leftover guard in pulumi-app-apply.sh skips objects
    # with this label, overrides included.
    k8s_yaml_local(
        ['sandbox.yaml'],
        local_overrides='configmaps/sandbox-env.local.yaml',
        labels={'ol.mit.edu/yaml-by-design': 'true'},
    )

    k8s_resource(
        'learnai-sandbox',
        objects=['learnai-sandbox-tls:apisixtls', 'learnai-sandbox-route:apisixroute'],
        labels=['learn-ai'],
        trigger_mode=TRIGGER_MODE_MANUAL,
        resource_deps=[DEPLOY_NAME],
    )
