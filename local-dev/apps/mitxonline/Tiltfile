# mitxonline Tiltfile
# Builds the mitxonline Django app (granian) and deploys it to the mitxonline namespace.
# When the sibling mitxonline repo is not checked out, Tilt uses the prebuilt
# DockerHub image (mitodl/mitxonline-app:latest) without attempting a local build.

load("../../tiltlib.star", "k8s_yaml_local")

workspace_root = os.environ.get("MITOL_WORKSPACE_ROOT", config.main_dir + "/..")
APP_DIR = os.path.join(workspace_root, "mitxonline")
IMAGE = 'mitodl/mitxonline-app'
NAMESPACE = 'mitxonline'
DEPLOY_NAME = 'mitxonline-webapp'

if os.path.exists(os.path.join(APP_DIR, '.git')):
    # Build the `local-dev` target: `production` (the only target that bakes in
    # the compiled webpack frontend, which checkout needs since that flow still
    # runs through mitxonline.mit.dev) plus dev deps (pytest, ipdb, ...) and
    # watchfiles so granian can --reload (see deployment.yaml).
    docker_build(
        IMAGE,
        context=APP_DIR,
        target='local-dev',
        dockerfile=APP_DIR + '/Dockerfile',
        # .claude/ holds agent worktrees; syncing one into the pod restarted it in a loop.
        ignore=['.claude/'],
        # Sync the whole repo: Django apps are top-level dirs (courses,
        # ecommerce, cms, ...). granian's --reload-ignore-dirs filters the
        # non-Python churn.
        live_update=[
            sync(APP_DIR, '/src'),
            # Reinstall deps on pyproject.toml/uv.lock change (uv, not pip;
            # dev deps included, matching the local-dev image; --inexact keeps
            # the image's extra watchfiles install).
            run(
                'cd /src && uv sync --frozen --inexact',
                trigger=[APP_DIR + '/pyproject.toml', APP_DIR + '/uv.lock'],
            ),
        ],
    )

# Spike for docs/plans/local-dev-deployed-parity.md (Tilt Option 1): when the
# gitignored marker pulumi-pilot.local.yaml exists, the workloads come from the
# deployed definition through local-dev/infra/apps/mitxonline (pulumi up as a
# k8s_custom_deploy) instead of deployment.yaml. Routes stay hand-written.
PILOT_DIR = os.path.join(config.main_dir, 'local-dev/infra/apps/mitxonline')
pilot = str(read_file('pulumi-pilot.local.yaml', default='')).strip() != ''

if pilot:
    # pulumi up waits for the pre-deploy migrate Job, which outlasts Tilt's 30s
    # default.
    update_settings(k8s_upsert_timeout_secs=300)
    rd = os.environ.get('LOCAL_DEV_ROOT_DOMAIN', 'mit.dev')
    routes = str(read_file('apisix-routes.yaml')).replace('mit.dev', rd)
    # The component serves Granian on 8073 with no nginx sidecar in front.
    k8s_yaml(blob(routes.replace('servicePort: 8010', 'servicePort: 8073')))
    k8s_custom_deploy(
        # Named after the hand-written webapp resource so the seed resources'
        # resource_deps still resolve.
        DEPLOY_NAME,
        apply_cmd=[PILOT_DIR + '/apply.sh', 'up'],
        delete_cmd=[PILOT_DIR + '/apply.sh', 'down'],
        apply_env={'LOCAL_DEV_ROOT_DOMAIN': rd},
        delete_env={'LOCAL_DEV_ROOT_DOMAIN': rd},
        deps=[
            PILOT_DIR + '/__main__.py',
            os.path.join(config.main_dir, 'src/ol_infrastructure/applications/mitxonline/definition.py'),
            'configmaps/app-env.yaml',
            'configmaps/app-env.local.yaml',
            'secrets.yaml',
        ],
        image_deps=[IMAGE],
    )
    k8s_resource(
        DEPLOY_NAME,
        port_forwards=['8010:8073'],
        labels=['mitxonline'],
        resource_deps=['local-infra-apps'],
    )
else:
    k8s_yaml_local([
        'configmaps/app-env.yaml',
        'configmaps/nginx.yaml',
        'secrets.yaml',
        'deployment.yaml',
        'apisix-routes.yaml',
    ], local_overrides='configmaps/app-env.local.yaml')

    k8s_resource(
        DEPLOY_NAME,
        port_forwards=['8010:8010'],
        labels=['mitxonline'],
        resource_deps=['local-infra-apps'],
    )

    k8s_resource('mitxonline-celery', labels=['mitxonline'], resource_deps=['local-infra-apps'])
    k8s_resource('mitxonline-celery-beat', labels=['mitxonline'], resource_deps=['local-infra-apps'])
