# ol-analytics-api Tiltfile
# Builds the FastAPI analytics gateway and deploys it to the ol-analytics-api
# namespace, behind analytics.learn.<root-domain> the way MIT Learn's dashboard
# reaches it when deployed. When the sibling ol-analytics-api repo is not
# checked out, the published mitodl/ol-analytics-api-app image runs (latest, or
# the prebuilt_tags pin).

load("../../tiltlib.star", "k8s_yaml_local", "current_root_domain", "prebuilt_image_tags_env")

workspace_root = os.environ.get("MITOL_WORKSPACE_ROOT", config.main_dir + "/..")
APP_DIR = os.path.join(workspace_root, "ol-analytics-api")
IMAGE = 'mitodl/ol-analytics-api-app'
# Must equal the root Tiltfile's deploy_name for ol-analytics-api (the component
# names the Deployment ol-analytics-api-app).
DEPLOY_NAME = 'ol-analytics-api-app'
PROGRAM_DIR = os.path.join(config.main_dir, 'local-dev/apps/ol-analytics-api/pulumi')
APPLY = os.path.join(config.main_dir, 'local-dev/scripts/pulumi-app-apply.sh')
root_domain = current_root_domain()
HAS_CHECKOUT = os.path.exists(os.path.join(APP_DIR, '.git'))

# Its StarRocks pool is opened at startup, so without the lake the pod
# crash-loops on an unresolvable host; and every dashboard request is gated on
# MITx Online's org-manager check.
_enabled = os.environ.get("LOCAL_DEV_ENABLED_APPS", "").split(",")
_missing = [app for app in ("data-platform", "mitxonline") if app not in _enabled]
if _missing:
    fail("ol-analytics-api needs %s in enabled_apps as well." % " and ".join(_missing))

if HAS_CHECKOUT:
    docker_build(
        IMAGE,
        context=APP_DIR,
        dockerfile=APP_DIR + '/Dockerfile',
        # .claude/ holds agent worktrees, which are not part of the app.
        ignore=['.claude/'],
        # The project is installed editable over /app/src, and the program runs
        # granian with --reload on the image Tilt built, so a sync is all a code
        # edit needs. The runtime image has no uv, so a dependency change
        # rebuilds it.
        live_update=[
            fall_back_on([APP_DIR + '/pyproject.toml', APP_DIR + '/uv.lock']),
            sync(APP_DIR + '/src', '/app/src'),
        ],
    )

# ApisixTls is hand-written: the deployed program gets it from an
# OLCertManagerCert this program does not render. It references the
# local-dev-tls wildcard the core stack writes into this namespace.
k8s_yaml_local(['apisix-tls.yaml'])
k8s_resource(
    new_name='ol-analytics-api-tls',
    objects=['ol-analytics-api-tls:apisixtls'],
    labels=['ol-analytics-api'],
    resource_deps=['local-infra-core'],
)

# The workload and the gateway route come from the deployed definition,
# rendered by local-dev/apps/ol-analytics-api/pulumi (pulumi up as a custom
# deploy).
prebuilt_tags = prebuilt_image_tags_env(IMAGE)
k8s_custom_deploy(
    DEPLOY_NAME,
    apply_cmd=[APPLY, 'ol-analytics-api', 'up'],
    delete_cmd=[APPLY, 'ol-analytics-api', 'down'],
    # The pin and the root domain reach the program through the environment;
    # naming them here makes a change re-apply, which os.putenv alone would not.
    # Only this app's pin is passed, so toggling another pinned app does not
    # re-apply this.
    apply_env={'LOCAL_DEV_ROOT_DOMAIN': root_domain, 'LOCAL_DEV_PREBUILT_IMAGE_TAGS': prebuilt_tags},
    delete_env={'LOCAL_DEV_ROOT_DOMAIN': root_domain, 'LOCAL_DEV_PREBUILT_IMAGE_TAGS': prebuilt_tags},
    # Everything the render reads; .tiltignore keeps __pycache__ out of these.
    # mitxonline's inputs.py holds the MITx Online client pair the Secret carries.
    deps=[
        PROGRAM_DIR,
        APPLY,
        os.path.join(config.main_dir, 'local-dev/scripts/pulumi-clear-stale-lock.sh'),
        os.path.join(config.main_dir, 'local-dev/scripts/pulumi-pending-objects.py'),
        os.path.join(config.main_dir, 'local-dev/scripts/pulumi-plugins.py'),
        os.path.join(config.main_dir, 'src/ol_infrastructure/applications/ol_analytics_api'),
        os.path.join(config.main_dir, 'src/ol_infrastructure/components/services'),
        os.path.join(config.main_dir, 'src/ol_infrastructure/lib'),
        os.path.join(config.main_dir, 'src/bridge/lib'),
        os.path.join(config.main_dir, 'local-dev/apps/mitxonline/pulumi/inputs.py'),
        'secrets.yaml',
    ],
    # Without a checkout nothing registers the image, and naming it here would
    # fail the Tiltfile load; the program then runs the published image.
    image_deps=[IMAGE] if HAS_CHECKOUT else [],
)
k8s_resource(
    DEPLOY_NAME,
    labels=['ol-analytics-api'],
    # local-infra-apps writes ol-mitlearn-oidc, which the rendered route reads.
    resource_deps=['local-infra-apps'],
    links=[
        link('https://analytics.learn.' + root_domain + '/api/v1/analytics/docs', 'b2b_dashboard API docs'),
    ],
)
