{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'local>mitodl/.github:renovate-config',
  ],
  packageRules: [
    {
      groupName: 'pulumi-plugins',
      matchPackageNames: [
        'pulumi{/,}**',
      ],
    },
    {
      // The aws-eks-addon datasource requires packageName to be a minified JSON
      // object rather than a plain string, so it cannot be written directly in the
      // versions.py marker comment the way every other datasource's can: raw JSON
      // in a `#` comment trips ruff's ERA001 (commented-out code), and a `# noqa`
      // appended to silence that would sit between the marker and the assignment
      // and break the custom manager's regex. Building it here from depName keeps
      // the comments uniform and lets the one generic manager handle these too.
      //
      // Without this, the addons resolved to an unparseable packageName and
      // Renovate skipped them silently -- which is why EFS_CSI_DRIVER_VERSION sat
      // at v2.1.6-eksbuild.1 while production had long since moved to v3.4.1.
      //
      // kubernetesVersion is deliberately left out of the filter so this does not
      // silently go stale on every cluster upgrade. The cost is that Renovate may
      // propose a version not offered for our Kubernetes version;
      // get_eks_addon_version() validates the pin and raises at preview time, so
      // that fails loudly in CI rather than reaching a cluster.
      //
      // CAVEAT -- this rule is necessary but not sufficient, and these pins are
      // still not being updated automatically. The dependency dashboard reports
      // `Failed to look up aws-eks-addon package {"addonName":"aws-ebs-csi-driver"}:
      // no-result` (and the same for aws-efs-csi-driver). The override is working:
      // the error echoes back well-formed JSON, and the datasource treats
      // kubernetesVersion as optional. The most likely remaining cause is
      // credentials -- the datasource calls eks:DescribeAddonVersions, which our
      // Mend-hosted Renovate has no obvious way to be authorized for. That has not
      // been confirmed against the Mend side, so it is a lead, not a diagnosis.
      //
      // So the original failure mode has recurred for a different reason: as of
      // 2026-09-08 the pins had drifted to v1.63.0-eksbuild.1 (AWS offered
      // v1.65.0-eksbuild.1) and v3.4.1-eksbuild.1 (AWS offered v3.4.2-eksbuild.1),
      // and were bumped by hand. Until Renovate can authenticate to AWS, treat
      // these two constants as manually maintained and check both with:
      //   k=$(aws eks describe-cluster-versions --default-only --cluster-type eks \
      //     --query 'clusterVersions[].clusterVersion' --output text)
      //   for a in aws-ebs-csi-driver aws-efs-csi-driver; do
      //     echo "$a: $(aws eks describe-addon-versions --addon-name "$a" \
      //       --kubernetes-version "$k" \
      //       --query 'addons[0].addonVersions[0].addonVersion' --output text)"
      //   done
      matchDatasources: [
        'aws-eks-addon',
      ],
      overridePackageName: '{"addonName":"{{{depName}}}"}',
    },
  ],
  pip_requirements: {
    managerFilePatterns: [
      '/dockerfiles/openedx-edxapp/pip_package_lists/.*?/.*.txt/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^src/bridge/lib/versions.py$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>.+?)(?: packageName=(?<packageName>.+?))?(?: registryUrl=(?<registryUrl>.+?))?(?: versioning=(?<versioning>[a-z-]+?))?\\s*.+\\s*=\\s*"(?<currentValue>.+?)"',
      ],
    },
  ],
}
