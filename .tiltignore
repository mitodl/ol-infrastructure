# Tilt ignore patterns — files/directories excluded from watch triggers
# These patterns prevent unnecessary Tilt updates when generated files change

# Python cache directories and files
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Python test/build artifacts
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/*.egg-info/
**/dist/
**/build/

# Node.js artifacts
**/node_modules/
**/.next/

# Pulumi state and artifacts. Stack files (Pulumi.<stack>.yaml) stay watched:
# the local apps' gitignored stack file is how a developer sets env and memory
# limits, so Tilt must re-apply on it; nothing rewrites a stack file after
# `stack select --create` creates it on the first apply.
.pulumi/
**/*.auto.tfvars.json

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
